# 7. METRICS + CP + TACP (same as v3.2)
# ══════════════════════════════════════════════════════════════
def compute_ece(probs, labels, nb=10):
    conf=np.max(probs,1);pred=np.argmax(probs,1);corr=(pred==labels).astype(float)
    edges=np.linspace(0,1,nb+1);ece=0.;bins=[]
    for i in range(nb):
        m=(conf>edges[i])&(conf<=edges[i+1])
        if m.sum()==0: bins.append({"n":0}); continue
        ba,bc=corr[m].mean(),conf[m].mean()
        ece+=m.sum()/len(labels)*abs(ba-bc)
        bins.append({"n":int(m.sum()),"acc":float(ba),"conf":float(bc)})
    return float(ece),bins

def bootstrap_ci(values, n_boot=1000, ci=95):
    values=np.array(values)
    if len(values)<2: return (float(values[0]),float(values[0]))
    boots=[np.mean(np.random.choice(values,len(values),replace=True)) for _ in range(n_boot)]
    lo=(100-ci)/2; return (float(np.percentile(boots,lo)),float(np.percentile(boots,100-lo)))

class CP:
    def __init__(s,a=0.05): s.a=a;s.q=None
    def calibrate(s,p,y):
        n=len(y);sc=1.-p[np.arange(n),y]
        s.q=float(np.quantile(sc,min(np.ceil((n+1)*(1-s.a))/n,1.),method="higher"))
    def sets(s,p):
        return [{k for k in range(p.shape[1]) if p[i,k]>=1.-s.q} or {int(np.argmax(p[i]))} for i in range(len(p))]
    def ev(s,ss,y):
        n=len(y)
        return {"coverage":sum(y[i] in ss[i] for i in range(n))/n,
                "avg_set_size":np.mean([len(x) for x in ss]),
                "singleton_rate":sum(len(x)==1 for x in ss)/n}

class TACP:
    def __init__(s,alpha=0.05,gamma=0.5):
        s.alpha=alpha;s.gamma=gamma;s.q_base=None;s.c_min=0;s.c_max=1
    @staticmethod
    def graph_topo_complexity(graphs):
        cx=[]
        for g in graphs:
            if hasattr(g,'topo') and g.topo is not None:
                t=g.topo.numpy() if torch.is_tensor(g.topo) else g.topo
                cx.append(0.5*t[:,0].mean()+0.5*t[:,3].mean())
            else: cx.append(0.0)
        return np.array(cx)
    def calibrate(s,p,y,cal_g):
        n=len(y);sc=1.-p[np.arange(n),y]
        cc=s.graph_topo_complexity(cal_g);s.c_min,s.c_max=cc.min(),cc.max()
        cn=(cc-s.c_min)/(s.c_max-s.c_min) if s.c_max>s.c_min else np.zeros_like(cc)
        sa=sc/(1+s.gamma*cn)
        s.q_base=float(np.quantile(sa,min(np.ceil((n+1)*(1-s.alpha))/n,1.),method="higher"))
    def sets(s,p,tg):
        tc=s.graph_topo_complexity(tg)
        cn=np.clip((tc-s.c_min)/(s.c_max-s.c_min),0,1) if s.c_max>s.c_min else np.zeros_like(tc)
        so,th=[],[]
        for i in range(len(p)):
            qi=s.q_base*(1+s.gamma*cn[i]);th.append(qi)
            si={k for k in range(p.shape[1]) if p[i,k]>=1.-qi}
            so.append(si or {int(np.argmax(p[i]))})
        return so,th
    def ev(s,ss,y,th=None):
        n=len(y)
        r={"tacp_coverage":sum(y[i] in ss[i] for i in range(n))/n,
           "tacp_avg_set_size":np.mean([len(x) for x in ss]),
           "tacp_singleton_rate":sum(len(x)==1 for x in ss)/n}
        if th: r["tacp_mean_q"]=float(np.mean(th));r["tacp_std_q"]=float(np.std(th))
        return r

def cov_sweep(cp,cy,tp,ty):
    out=[]
    for a in [.01,.02,.05,.10,.15,.20,.25]:
        c=CP(a);c.calibrate(cp,cy);e=c.ev(c.sets(tp),ty);e["alpha"]=a;out.append(e)
    return out

def tacp_sweep(cp,cy,cg,tp,ty,tg):
    out=[]
    for a in [.01,.02,.05,.10,.15,.20,.25]:
        for g in [0.25,0.5,0.75,1.0]:
            t=TACP(a,g);t.calibrate(cp,cy,cg);ss,at=t.sets(tp,tg)
            e=t.ev(ss,ty,at);e["alpha"]=a;e["gamma"]=g;out.append(e)
    return out

def sel_sweep(ale,epi,pred,lab):
    out=[]
    for pct in range(50,95,5):
        at,et=np.percentile(ale,pct),np.percentile(epi,pct)
        dec=["escalate" if e>et else "defer" if a>at else "accept" for a,e in zip(ale,epi)]
        na=sum(d=="accept" for d in dec)
        ac=sum(p==y for d,p,y in zip(dec,pred,lab) if d=="accept")/max(na,1)
        out.append({"pct":pct,"acc_rate":na/max(len(dec),1),"acc_acc":ac})
    return out

# ══════════════════════════════════════════════════════════════
# 8. ENGINE
# ══════════════════════════════════════════════════════════════
class Engine:
    def __init__(s,model,mt,is_cbis=False):
        s.m=model.to(DEV);s.is_edl=mt in EDL_SET
        s.opt=Adam(model.parameters(),lr=cfg.LR,weight_decay=cfg.WD)
        s.sch=CosineAnnealingLR(s.opt,T_max=cfg.EPOCHS)
        # Use variant class weights if specified
        cw = CW_MAP.get(mt, cfg.CLS_W)
        s.loss_fn=(EDLLoss(cfg.N_CLS,class_weights=cw).to(DEV)
                   if s.is_edl
                   else nn.CrossEntropyLoss(weight=cw.to(DEV)))
        s.patience=cfg.PAT_CBIS if is_cbis else cfg.PAT_INB

    def train_ep(s,loader,epoch):
        s.m.train();tl,n=0.,0
        for b in loader:
            b=b.to(DEV);s.opt.zero_grad();out=s.m(b)
            loss=(s.loss_fn(out,b.y,epoch,cfg.EPOCHS) if s.is_edl else s.loss_fn(out,b.y))
            loss.backward();torch.nn.utils.clip_grad_norm_(s.m.parameters(),1.)
            s.opt.step();tl+=loss.item()*b.y.size(0);n+=b.y.size(0)
        s.sch.step(); return tl/max(n,1)

    @torch.no_grad()
    def evaluate(s,loader):
        s.m.eval()
        ap,ay,aa,ae=[],[],[],[]
        for b in loader:
            b=b.to(DEV);p,al,ep,_=s.m.predict(b)
            ap.append(p.cpu().numpy());ay.append(b.y.cpu().numpy())
            aa.append(al.cpu().numpy());ae.append(ep.cpu().numpy())
        probs,labels=np.concatenate(ap),np.concatenate(ay)
        ale,epi=np.concatenate(aa),np.concatenate(ae)
        preds=np.argmax(probs,1);u=np.unique(labels)
        m={"auc":roc_auc_score(labels,probs[:,1]) if len(u)>1 else 0.,
           "auprc":average_precision_score(labels,probs[:,1]) if len(u)>1 else 0.,
           "f1":f1_score(labels,preds,zero_division=0),
           "accuracy":accuracy_score(labels,preds),
           "precision":precision_score(labels,preds,zero_division=0),
           "recall":recall_score(labels,preds,zero_division=0),
           "brier":brier_score_loss(labels,probs[:,1])}
        ece,bins=compute_ece(probs,labels);m["ece"]=ece
        return m,probs,labels,preds,ale,epi,bins

    def train_full(s,tr,vl,sp=None):
        best,state,pat=0.,None,0
        ep_bar=tqdm(range(1,cfg.EPOCHS+1),desc="      Training",leave=False,unit="ep",position=2)
        for ep in ep_bar:
            lo=s.train_ep(tr,ep);vm,*_=s.evaluate(vl)
            ep_bar.set_postfix_str(f"L={lo:.4f} AUC={vm['auc']:.3f} F1={vm['f1']:.3f}")
            if ep%10==0 or ep==1:
                tqdm.write(f"      Ep{ep:3d} L={lo:.4f} AUC={vm['auc']:.4f} F1={vm['f1']:.4f}")
            if vm["auc"]>best:
                best=vm["auc"];state={k:v.clone() for k,v in s.m.state_dict().items()};pat=0
            else: pat+=1
            if pat>=s.patience:
                tqdm.write(f"      Stop@{ep} best={best:.4f}"); break
        ep_bar.close()
        if state: s.m.load_state_dict(state)
        if sp: torch.save(state or s.m.state_dict(), sp)
        return best

# ══════════════════════════════════════════════════════════════
# 9. PATIENT SPLIT
# ══════════════════════════════════════════════════════════════
def pat_split(graphs,labels,seed=42):
    pids=np.array([str(g.pid_hash.item()) for g in graphs]);upids=np.unique(pids)
    if len(upids)<4:
        idx=np.random.RandomState(seed).permutation(len(graphs));n=len(idx)
        return (idx[:n//2].tolist(),idx[n//2:n*65//100].tolist(),
                idx[n*65//100:n*80//100].tolist(),idx[n*80//100:].tolist())
    yp={pid:lab for pid,lab in zip(pids,labels)};pl=np.array([yp[p] for p in upids])
    for attempt in range(20):
        s=seed+attempt*111
        try:
            t1,r1=next(GroupShuffleSplit(1,test_size=.50,random_state=s).split(np.arange(len(upids)),pl,upids))
            rp,rl=upids[r1],pl[r1]
            if len(rp)<3: continue
            v1,r2=next(GroupShuffleSplit(1,test_size=.70,random_state=s).split(np.arange(len(rp)),rl,rp))
            rp2,rl2=rp[r2],rl[r2]
            if len(rp2)<3: continue
            c1,t2=next(GroupShuffleSplit(1,test_size=.571,random_state=s).split(np.arange(len(rp2)),rl2,rp2))
            sets={"tr":set(upids[t1]),"vl":set(rp[v1]),"cl":set(rp2[c1]),"ts":set(rp2[t2])}
            result=tuple([i for i,g in enumerate(graphs) if str(g.pid_hash.item()) in sets[k]] for k in ["tr","vl","cl","ts"])
            if all(len(set(labels[i] for i in idx))>=2 for idx in result if len(idx)>0): return result
        except: continue
    idx=np.random.RandomState(seed).permutation(len(graphs));n=len(idx)
    return (idx[:n//2].tolist(),idx[n//2:n*65//100].tolist(),
            idx[n*65//100:n*80//100].tolist(),idx[n*80//100:].tolist())

# ══════════════════════════════════════════════════════════════
# 10. EXPERIMENT RUNNER
# ══════════════════════════════════════════════════════════════
def load_graphs(cache):
    gs,ls=[],[]
    for p in sorted(Path(cache).glob("*.pt")):
        d=torch.load(p,weights_only=False);gs.append(d);ls.append(d.y.item())
    return gs,ls

def run_exp(name, tc, ec, seed, mt):
    rk = f"{name}_s{seed}"
    rp = RESULTS / f"{rk}.json"
    mp = CKPT_DIR / f"{rk}.pt"

    if rp.exists():
        res = json.load(open(rp))
        tqdm.write(f"    [CACHED] {rk} AUC={res['auc']:.4f} F1={res['f1']:.4f} "
                   f"AUPRC={res.get('auprc',0):.4f}")
        tracker.record_seed(name, 0, was_cached=True)
        return res

    tqdm.write(f"\n    [RUN] {rk} | {mt}")
    t0 = time.time()
    cmap_local = {"inb": CACHE_INB, "cbis": CACHE_CBIS}
    tg, tl = load_graphs(cmap_local[tc])
    cross = ec is not None
    is_cbis = "cbis" in tc

    torch.manual_seed(seed); np.random.seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False

    if cross:
        eg, el = load_graphs(cmap_local[ec])
        itr, ivl, _, _ = pat_split(tg, tl, seed)
        _, _, icl, its = pat_split(eg, el, seed)
        test_raw = [eg[i] for i in its]; cal_raw = [eg[i] for i in icl]
        trl = PyGDataLoader([tg[i] for i in itr], cfg.BS, shuffle=True)
        vll = PyGDataLoader([tg[i] for i in ivl], cfg.BS)
        cll = PyGDataLoader([eg[i] for i in icl], cfg.BS)
        tsl = PyGDataLoader([eg[i] for i in its], cfg.BS)
    else:
        itr, ivl, icl, its = pat_split(tg, tl, seed)
        test_raw = [tg[i] for i in its]; cal_raw = [tg[i] for i in icl]
        trl = PyGDataLoader([tg[i] for i in itr], cfg.BS, shuffle=True)
        vll = PyGDataLoader([tg[i] for i in ivl], cfg.BS)
        cll = PyGDataLoader([tg[i] for i in icl], cfg.BS)
        tsl = PyGDataLoader([tg[i] for i in its], cfg.BS)

    tqdm.write(f"      Split: tr={len(itr)} vl={len(ivl)} cl={len(icl)} ts={len(its)}")

    model = MODELS[mt]()
    eng = Engine(model, mt, is_cbis=is_cbis)
    if mp.exists():
        model.load_state_dict(torch.load(mp, weights_only=True, map_location=DEV))
        model.to(DEV); eng.m = model; tt = 0.
    else:
        t1 = time.time(); eng.train_full(trl, vll, sp=mp); tt = time.time() - t1

    _, cal_p, cal_y, _, cal_a, cal_e, _ = eng.evaluate(cll)
    tm, tst_p, tst_y, tst_pd, tst_a, tst_e, tst_bins = eng.evaluate(tsl)

    cp = CP(cfg.ALPHA); cp.calibrate(cal_p, cal_y)
    ss = cp.sets(tst_p); cfr = cp.ev(ss, tst_y)
    csw = cov_sweep(cal_p, cal_y, tst_p, tst_y)

    tacp = TACP(cfg.ALPHA, cfg.TACP_GAMMA)
    tacp.calibrate(cal_p, cal_y, cal_raw)
    tacp_ss, tacp_at = tacp.sets(tst_p, test_raw)
    tacp_ev = tacp.ev(tacp_ss, tst_y, tacp_at)
    tacp_sw = tacp_sweep(cal_p, cal_y, cal_raw, tst_p, tst_y, test_raw)

    ssw = sel_sweep(tst_a, tst_e, tst_pd, tst_y)
    at75 = np.percentile(cal_a, 75); et75 = np.percentile(cal_e, 75)
    dec = ["escalate" if e > et75 else "defer" if a > at75 else "accept"
           for a, e in zip(tst_a, tst_e)]
    na = sum(d == "accept" for d in dec)
    sel = {"accept_rate": na / max(len(dec), 1),
           "accept_acc": sum(p == y for d, p, y in zip(dec, tst_pd, tst_y)
                            if d == "accept") / max(na, 1)}

    cvc = {}
    for c in [0, 1]:
        mk = tst_y == c
        if mk.sum() > 0:
            cvc[f"cov_c{c}"] = sum(tst_y[i] in ss[i] for i in range(len(tst_y)) if mk[i]) / mk.sum()
            cvc[f"tacp_cov_c{c}"] = sum(tst_y[i] in tacp_ss[i] for i in range(len(tst_y)) if mk[i]) / mk.sum()

    tn, fp, fn_n, tp_n = confusion_matrix(tst_y, tst_pd, labels=[0, 1]).ravel()
    sens = tp_n / max(tp_n + fn_n, 1)
    fnr = fn_n / max(tp_n + fn_n, 1)

    fna = [{"pid": str(test_raw[i].pid_hash.item()), "p_mal": float(tst_p[i, 1])}
           for i in range(len(tst_y)) if tst_y[i] == 1 and tst_pd[i] == 0]

    avg_sp = np.mean([g.n_spatial.item() for g in test_raw
                      if hasattr(g, 'n_spatial')]) if any(
                      hasattr(g, 'n_spatial') for g in test_raw) else 0
    avg_tp = np.mean([g.n_topo_new.item() for g in test_raw
                      if hasattr(g, 'n_topo_new')]) if any(
                      hasattr(g, 'n_topo_new') for g in test_raw) else 0

    seed_time = time.time() - t0
    res = {"exp": name, "seed": seed, "model": mt, "cross": cross,
           **tm, **cfr, **tacp_ev, **sel, **cvc,
           "sens": sens, "fnr": fnr,
           "spec": tn / max(tn + fp, 1),
           "tp": int(tp_n), "tn": int(tn), "fp": int(fp), "fn": int(fn_n),
           "q": cp.q, "tacp_q_base": tacp.q_base,
           "bins": tst_bins, "cov_sweep": csw, "tacp_sweep": tacp_sw,
           "sel_sweep": ssw, "fna": fna,
           "avg_spatial_edges": float(avg_sp),
           "avg_topo_new_edges": float(avg_tp),
           "train_t": tt, "total_t": seed_time}

    json.dump(res, open(rp, "w"), indent=2, default=str)
    tqdm.write(f"    ✓ AUC={tm['auc']:.4f} AUPRC={tm['auprc']:.4f} "
               f"F1={tm['f1']:.4f} Sens={sens:.3f} [{seed_time:.0f}s]")
    tracker.record_seed(name, seed_time)
    del model, eng; gc.collect()
    if DEV.type == "cuda": torch.cuda.empty_cache()
    return res

