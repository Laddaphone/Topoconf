class ProgressTracker:
    def __init__(s, experiments):
        s.experiments = experiments
        s.total_seeds = sum(ns for _, _, _, ns, _ in experiments)
        s.seed_times = {}; s.completed = 0; s.skipped = 0; s.failed = 0
        s.master_bar = None

    def init_master_bar(s, results_dir):
        done = {f.stem for f in results_dir.glob("*.json")}
        for name, _, _, ns, _ in s.experiments:
            for sd in range(42, 42 + ns):
                if f"{name}_s{sd}" in done:
                    s.skipped += 1
        s.completed = s.skipped
        s.master_bar = tqdm(
            total=s.total_seeds, initial=s.skipped,
            desc="🧬 Overall", unit="seed",
            bar_format="{l_bar}{bar}| {n_fmt}/{total_fmt} [{elapsed}<{remaining}] {postfix}",
            position=0, leave=True)
        s._update()
        if s.skipped > 0:
            print(f"  ℹ️  {s.skipped} seeds cached, resuming...")
        return s.total_seeds - s.skipped

    def record_seed(s, exp_name, seed_time, was_cached=False):
        if not was_cached:
            s.seed_times.setdefault(exp_name, []).append(seed_time)
        s.completed += 1
        if s.master_bar:
            s.master_bar.update(1 if not was_cached else 0)
            s._update()

    def record_fail(s):
        s.failed += 1; s.completed += 1
        if s.master_bar: s.master_bar.update(1); s._update()

    def _update(s):
        elapsed = time.time() - WALL_T0
        all_t = [t for ts in s.seed_times.values() for t in ts]
        eta = str(timedelta(seconds=int(
            (s.total_seeds - s.completed) * np.mean(all_t)))) if all_t else "..."
        s.master_bar.set_postfix_str(
            f"Done={s.completed} Skip={s.skipped} Fail={s.failed} ETA={eta}")

    def close(s):
        if s.master_bar: s.master_bar.close()

tracker = ProgressTracker(cfg.EXPERIMENTS)

