class ResNetBackbone(nn.Module):
    def __init__(s, d_out=128):
        super().__init__()
        base = resnet18(weights=ResNet18_Weights.DEFAULT)
        s.conv1 = nn.Conv2d(1, 64, 7, stride=2, padding=3, bias=False)
        with torch.no_grad():
            s.conv1.weight = nn.Parameter(base.conv1.weight.mean(dim=1, keepdim=True))
        s.bn1=base.bn1;s.relu=base.relu;s.maxpool=base.maxpool
        s.layer1=base.layer1;s.layer2=base.layer2;s.layer3=base.layer3
        s.pool=nn.AdaptiveAvgPool2d(1);s.fc=nn.Linear(256, d_out)
    def forward(s, x):
        h=s.maxpool(s.relu(s.bn1(s.conv1(x))))
        return s.fc(s.pool(s.layer3(s.layer2(s.layer1(h)))).squeeze(-1).squeeze(-1))

class GatedTopoFusion(nn.Module):
    def __init__(s, vis_d, topo_d, out_d):
        super().__init__()
        s.topo_mlp=nn.Sequential(nn.Linear(topo_d,vis_d),nn.LayerNorm(vis_d),nn.ELU())
        s.gate=nn.Sequential(nn.Linear(topo_d,vis_d),nn.Sigmoid())
        s.out=nn.Linear(vis_d,out_d)
    def forward(s,vis,topo):
        g=s.gate(topo); return s.out(g*vis+(1-g)*s.topo_mlp(topo))

class GATBlk(nn.Module):
    def __init__(s,di,do,h=4,dr=0.3):
        super().__init__()
        s.gat=GATConv(di,do//h,heads=h,dropout=dr,concat=True)
        s.norm=nn.LayerNorm(do);s.res=nn.Linear(di,do) if di!=do else nn.Identity()
    def forward(s,x,ei): return s.norm(F.elu(s.gat(x,ei))+s.res(x))

class TopoConfGNN(nn.Module):
    def __init__(s,topo=True):
        super().__init__()
        s.use_topo=topo;s.backbone=ResNetBackbone(d_out=cfg.VIS_D)
        if topo: s.fusion=GatedTopoFusion(cfg.VIS_D,cfg.TOPO_D,cfg.GAT_H)
        else: s.fusion=nn.Sequential(nn.Linear(cfg.VIS_D,cfg.GAT_H),nn.LayerNorm(cfg.GAT_H),nn.ELU())
        s.proj=nn.Sequential(nn.LayerNorm(cfg.GAT_H),nn.Dropout(cfg.DROP))
        s.gats=nn.ModuleList([GATBlk(cfg.GAT_H,cfg.GAT_H,cfg.GAT_HEADS,cfg.DROP) for _ in range(cfg.GAT_L)])
        s.readout=nn.Sequential(nn.Linear(cfg.GAT_H*2,cfg.GAT_H),nn.ELU(),nn.Dropout(cfg.DROP))
        s.evi=nn.Sequential(nn.Linear(cfg.GAT_H,cfg.N_CLS),nn.Softplus())
    def forward(s,d):
        vis=s.backbone(d.x)
        h=s.fusion(vis,d.topo) if s.use_topo and hasattr(d,'topo') else s.fusion(vis)
        h=s.proj(h)
        for g in s.gats: h=g(h,d.edge_index)
        return s.evi(s.readout(torch.cat([global_mean_pool(h,d.batch),global_max_pool(h,d.batch)],-1)))+1.0
    def predict(s,d):
        a=s.forward(d);S=a.sum(-1,keepdim=True);p=a/S
        ale=-torch.sum(p*torch.log(p+1e-10),-1)
        return p,ale,cfg.N_CLS/S.squeeze(-1),a

class BaseSM(nn.Module):
    def __init__(s):
        super().__init__()
        s.backbone=ResNetBackbone(d_out=cfg.VIS_D)
        s.proj=nn.Sequential(nn.Linear(cfg.VIS_D,cfg.GAT_H),nn.LayerNorm(cfg.GAT_H),nn.ELU())
        s.gats=nn.ModuleList([GATBlk(cfg.GAT_H,cfg.GAT_H,cfg.GAT_HEADS,cfg.DROP) for _ in range(cfg.GAT_L)])
        s.readout=nn.Sequential(nn.Linear(cfg.GAT_H*2,cfg.GAT_H),nn.ELU(),nn.Dropout(cfg.DROP))
        s.head=nn.Linear(cfg.GAT_H,cfg.N_CLS)
    def forward(s,d):
        h=s.proj(s.backbone(d.x))
        for g in s.gats: h=g(h,d.edge_index)
        return s.head(s.readout(torch.cat([global_mean_pool(h,d.batch),global_max_pool(h,d.batch)],-1)))
    def predict(s,d):
        lo=s.forward(d);p=F.softmax(lo,-1)
        ale=-torch.sum(p*torch.log(p+1e-10),-1)
        return p,ale,ale,lo

class BaseMCD(BaseSM):
    def predict(s,d):
        was=s.training;s.train()
        preds=[]
        with torch.no_grad():
            for _ in range(10): preds.append(F.softmax(s.forward(d),-1))
        if not was: s.eval()
        st=torch.stack(preds);p=st.mean(0)
        ale=-torch.sum(p*torch.log(p+1e-10),-1)
        return p,ale,st.var(0).sum(-1),p

class BaseGCN(nn.Module):
    def __init__(s):
        super().__init__()
        s.backbone=ResNetBackbone(d_out=cfg.VIS_D)
        s.proj=nn.Sequential(nn.Linear(cfg.VIS_D,cfg.GAT_H),nn.LayerNorm(cfg.GAT_H),nn.ELU())
        s.gcns=nn.ModuleList([GCNConv(cfg.GAT_H,cfg.GAT_H) for _ in range(cfg.GAT_L)])
        s.norms=nn.ModuleList([nn.LayerNorm(cfg.GAT_H) for _ in range(cfg.GAT_L)])
        s.readout=nn.Sequential(nn.Linear(cfg.GAT_H*2,cfg.GAT_H),nn.ELU(),nn.Dropout(cfg.DROP))
        s.head=nn.Linear(cfg.GAT_H,cfg.N_CLS)
    def forward(s,d):
        h=s.proj(s.backbone(d.x))
        for gc,n in zip(s.gcns,s.norms): h=n(F.elu(gc(h,d.edge_index))+h)
        return s.head(s.readout(torch.cat([global_mean_pool(h,d.batch),global_max_pool(h,d.batch)],-1)))
    def predict(s,d):
        lo=s.forward(d);p=F.softmax(lo,-1)
        ale=-torch.sum(p*torch.log(p+1e-10),-1)
        return p,ale,torch.zeros(p.shape[0],device=p.device),lo

class PureResNet(nn.Module):
    def __init__(s):
        super().__init__()
        base=resnet18(weights=ResNet18_Weights.DEFAULT)
        s.conv1=nn.Conv2d(1,64,7,stride=2,padding=3,bias=False)
        with torch.no_grad(): s.conv1.weight=nn.Parameter(base.conv1.weight.mean(dim=1,keepdim=True))
        s.bn1=base.bn1;s.relu=base.relu;s.maxpool=base.maxpool
        s.layer1=base.layer1;s.layer2=base.layer2;s.layer3=base.layer3;s.layer4=base.layer4
        s.pool=nn.AdaptiveAvgPool2d(1);s.fc=nn.Linear(512,cfg.N_CLS)
    def forward(s,d):
        h=s.maxpool(s.relu(s.bn1(s.conv1(d.x))))
        h=s.layer4(s.layer3(s.layer2(s.layer1(h))))
        h=s.pool(h).squeeze(-1).squeeze(-1)
        return s.fc(global_mean_pool(h,d.batch))
    def predict(s,d):
        lo=s.forward(d);p=F.softmax(lo,-1)
        ale=-torch.sum(p*torch.log(p+1e-10),-1)
        return p,ale,ale,lo

