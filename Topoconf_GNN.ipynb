# 6. LOSS
# ══════════════════════════════════════════════════════════════
class EDLLoss(nn.Module):
    def __init__(s, K=2, kl=0.01, class_weights=None):
        super().__init__(); s.K = K; s.kl = kl
        s.register_buffer('cw', class_weights.float() if class_weights is not None
                          else torch.ones(K))
    def forward(s, a, y, ep=0, tot=60):
        yoh = F.one_hot(y.long(), s.K).float()
        S = a.sum(-1, keepdim=True)
        nll = torch.sum(yoh * (torch.digamma(S) - torch.digamma(a)), -1)
        nll = nll * s.cw[y.long()]
        ann = min(1., ep / max(tot * 0.5, 1))
        at = a.clone(); at = at * (1 - yoh) + yoh
        St = at.sum(-1, keepdim=True)
        kl = (torch.lgamma(St) - torch.lgamma(torch.ones_like(St) * s.K)
              - torch.sum(torch.lgamma(at), -1, keepdim=True)
              + torch.sum((at - 1) * (torch.digamma(at) - torch.digamma(St)),
                          -1, keepdim=True))
        return (nll + ann * s.kl * kl.squeeze(-1)).mean()

