# 11. LIVE RESULTS
# ══════════════════════════════════════════════════════════════
def print_live_results():
    rs = [json.load(open(f)) for f in sorted(RESULTS.glob("*.json"))
          if not f.name.endswith(".csv")]
    if not rs: return
    df = pd.DataFrame(rs)
    print(f"\n{'━'*80}")
    print(f" 📊 LIVE RESULTS ({len(rs)} seeds)")
    print(f"{'━'*80}")
    print(f"  {'Experiment':25s} {'AUC':>12s} {'AUPRC':>12s} {'F1':>12s} "
          f"{'Sens':>8s} {'FNR':>8s}  n")
    for e, g in df.groupby("exp"):
        auc_s = f"{g['auc'].mean():.4f}±{g['auc'].std():.4f}"
        auprc_s = f"{g['auprc'].mean():.4f}±{g['auprc'].std():.4f}" if 'auprc' in g else "-"
        f1_s = f"{g['f1'].mean():.4f}±{g['f1'].std():.4f}"
        sens_s = f"{g['sens'].mean():.4f}" if 'sens' in g else "-"
        fnr_s = f"{g['fnr'].mean():.4f}" if 'fnr' in g else "-"
        print(f"  {e:25s} {auc_s:>12s} {auprc_s:>12s} {f1_s:>12s} "
              f"{sens_s:>8s} {fnr_s:>8s} {len(g):>3d}")
    # Cross-domain summary
    xd = df[df["cross"] == True]
    if len(xd) > 0:
        print(f"\n  Cross-domain:")
        for e, g in xd.groupby("exp"):
            print(f"    {e:25s} AUC={g['auc'].mean():.4f}±{g['auc'].std():.4f} "
                  f"Sens={g['sens'].mean():.4f} n={len(g)}")
    print(f"{'━'*80}")

# ══════════════════════════════════════════════════════════════
# 12. RUN ALL
# ══════════════════════════════════════════════════════════════
def run_all():
    remaining = tracker.init_master_bar(RESULTS)
    if remaining == 0:
        print("\n✅ All done!"); print_live_results(); tracker.close(); return

    cmap_local = {"inb": CACHE_INB, "cbis": CACHE_CBIS}
    exp_bar = tqdm(cfg.EXPERIMENTS, desc="📋 Experiments", unit="exp", position=1, leave=True)
    for en, tc, ec, ns, mt in exp_bar:
        exp_bar.set_postfix_str(f"{en}")

        td = cmap_local.get(tc, "")
        if not Path(td).exists() or not list(Path(td).glob("*.pt")):
            tqdm.write(f"\n[SKIP] {en} — no data"); continue
        if ec:
            ed = cmap_local.get(ec, "")
            if not Path(ed).exists() or not list(Path(ed).glob("*.pt")):
                tqdm.write(f"\n[SKIP] {en} — no test data"); continue

        tqdm.write(f"\n{'='*60}\n  {en} ({ns} seeds, {mt})\n{'='*60}")
        for s in range(42, 42 + ns):
            try: run_exp(en, tc, ec, s, mt)
            except Exception as e:
                tqdm.write(f"    [ERR] s{s}: {e}")
                import traceback; traceback.print_exc()
                tracker.record_fail()
        print_live_results()
    exp_bar.close(); tracker.close()

