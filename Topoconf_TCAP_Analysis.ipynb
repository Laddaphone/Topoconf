""
TACP Deep Analysis — Run in separate Colab cell while training continues.
Saves all figures as PNG + PDF to Drive.
"""

import json, numpy as np, matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from pathlib import Path
from collections import defaultdict
from scipy.stats import wilcoxon, ttest_rel
from scipy.stats import t as t_dist

matplotlib.rcParams.update({
    'font.size': 11, 'font.family': 'serif',
    'axes.labelsize': 12, 'axes.titlesize': 13,
    'figure.dpi': 150, 'savefig.dpi': 300,
    'savefig.bbox': 'tight'
})

RESULTS = Path("/content/drive/MyDrive/TopoConf_GNN/results_v31")
FIGS = RESULTS / "figures"
FIGS.mkdir(exist_ok=True)

rs = [json.load(open(f)) for f in sorted(RESULTS.glob("*.json"))
      if not f.name.endswith(".csv")]
print(f"Loaded {len(rs)} experiment results\n")

method_colors = {
    "TopoConf": "#d62728", "NoTopo": "#1f77b4",
    "Softmax": "#2ca02c", "MCDrop": "#ff7f0e", "GCN": "#9467bd"
}

# Collect per-method data
method_data = defaultdict(lambda: {"cp_mal": [], "tacp_mal": [],
                                    "cp_set": [], "tacp_set": []})
for r in rs:
    cp_mal = r.get("cov_c1")
    tacp_mal = r.get("tacp_cov_c1")
    cp_set = r.get("avg_set_size")
    tacp_set = r.get("tacp_avg_set_size")
    if None in (cp_mal, tacp_mal, cp_set, tacp_set):
        continue
    method_data[r["exp"]]["cp_mal"].append(cp_mal)
    method_data[r["exp"]]["tacp_mal"].append(tacp_mal)
    method_data[r["exp"]]["cp_set"].append(cp_set)
    method_data[r["exp"]]["tacp_set"].append(tacp_set)


# ═══════════════════════════════════════════════════════════
# 1. STATISTICAL TESTS
# ═══════════════════════════════════════════════════════════
print("=" * 70)
print(" 1. STATISTICAL TESTS: TACP vs CP (Malignant Coverage)")
print("=" * 70)

for name in sorted(method_data.keys()):
    d = method_data[name]
    cp = np.array(d["cp_mal"])
    tacp = np.array(d["tacp_mal"])
    delta = tacp - cp
    n = len(delta)
    if n < 2:
        continue

    mean_d = np.mean(delta)
    std_d = np.std(delta, ddof=1) if n > 1 else 0
    se = std_d / np.sqrt(n) if n > 1 else 0

    if n >= 3 and se > 0:
        t_crit = t_dist.ppf(0.975, df=n - 1)
        ci_lo = mean_d - t_crit * se
        ci_hi = mean_d + t_crit * se
    else:
        ci_lo, ci_hi = mean_d, mean_d

    print(f"\n--- {name} (n={n}) ---")
    print(f"  Per-seed deltas: {[f'{x:+.3f}' for x in delta]}")
    print(f"  Mean d_mal:      {mean_d:+.4f}")
    print(f"  Std:             {std_d:.4f}")
    print(f"  95% CI:          [{ci_lo:+.4f}, {ci_hi:+.4f}]")
    ci_status = ("SIGNIFICANT" if ci_lo > 0 else
                 "SIG NEGATIVE" if ci_hi < 0 else "NOT SIGNIFICANT")
    print(f"  CI assessment:   {ci_status}")

    if n >= 5 and np.any(delta != 0):
        try:
            stat, p = wilcoxon(delta, alternative='greater')
            print(f"  Wilcoxon (1-tail): p={p:.4f} {'*' if p < 0.05 else 'ns'}")
        except Exception as e:
            print(f"  Wilcoxon: {e}")

    if n >= 3 and se > 0:
        t_stat = mean_d / se
        p_t = 1 - t_dist.cdf(t_stat, df=n - 1)
        print(f"  Paired-t (1-tail): t={t_stat:.3f} p={p_t:.4f} "
              f"{'*' if p_t < 0.05 else 'ns'}")

    if n >= 4:
        print(f"  Leave-one-out:")
        for i in range(n):
            loo = np.delete(delta, i)
            lm = np.mean(loo)
            flag = " <-- FLIPS" if lm <= 0 and mean_d > 0 else ""
            print(f"    Drop idx {i} (d={delta[i]:+.3f}): mean={lm:+.4f}{flag}")

    if std_d > 0:
        cohens_d = mean_d / std_d
        mag = ("large" if abs(cohens_d) > 0.8 else
               "medium" if abs(cohens_d) > 0.5 else "small")
        print(f"  Cohen's d:       {cohens_d:.3f} ({mag})")


# ═══════════════════════════════════════════════════════════
# 2. CONDITIONAL EFFICIENCY (gamma sweep)
# ═══════════════════════════════════════════════════════════
print(f"\n\n{'='*70}")
print(f" 2. CONDITIONAL EFFICIENCY (gamma sweep at alpha=0.05)")
print(f"{'='*70}")

for exp_name in sorted(set(r["exp"] for r in rs)):
    seeds = [r for r in rs if r["exp"] == exp_name and "tacp_sweep" in r]
    if not seeds:
        continue

    gamma_data = defaultdict(lambda: {"cov": [], "set": [], "sing": []})
    cp_sets = []
    for r in seeds:
        cp_sets.append(r.get("avg_set_size", 2.0))
        a05 = [x for x in r["tacp_sweep"] if abs(x["alpha"] - 0.05) < 0.001]
        for entry in a05:
            g = entry["gamma"]
            gamma_data[g]["cov"].append(entry["tacp_coverage"])
            gamma_data[g]["set"].append(entry["tacp_avg_set_size"])
            gamma_data[g]["sing"].append(entry.get("tacp_singleton_rate", 0))

    if not gamma_data:
        continue

    mean_cp_set = np.mean(cp_sets)
    print(f"\n  {exp_name} (CP_set={mean_cp_set:.3f}):")
    print(f"  {'gamma':>7s} | {'cov':>7s} {'set':>7s} {'sing':>7s} | {'d_set':>7s}")
    print(f"  {'-'*7} | {'-'*7} {'-'*7} {'-'*7} | {'-'*7}")
    for g in sorted(gamma_data.keys()):
        mc = np.mean(gamma_data[g]["cov"])
        ms = np.mean(gamma_data[g]["set"])
        mg = np.mean(gamma_data[g]["sing"])
        ds = ms - mean_cp_set
        print(f"  {g:>7.2f} | {mc:>7.4f} {ms:>7.4f} {mg:>7.4f} | {ds:>+7.4f}")


# ═══════════════════════════════════════════════════════════
# FIGURE 1: TACP EFFICIENCY SCATTER
# ═══════════════════════════════════════════════════════════
print(f"\n\n{'='*70}")
print(f" FIGURE 1: TACP Efficiency Scatter")
print(f"{'='*70}")

fig, ax = plt.subplots(figsize=(8, 6))
ax.set_title("TACP Efficiency: Malignant Coverage Gain vs Set Size Cost", fontweight='bold')
ax.set_xlabel(r"$\Delta$ Set Size (TACP $-$ CP)")
ax.set_ylabel(r"$\Delta$ Malignant Coverage (TACP $-$ CP)")

for method, color in method_colors.items():
    for prefix in ["INB", "CBIS"]:
        exp_name = f"{prefix}_{method}"
        d = method_data.get(exp_name)
        if not d or len(d["cp_mal"]) < 2:
            continue

        d_mal = np.array(d["tacp_mal"]) - np.array(d["cp_mal"])
        d_set = np.array(d["tacp_set"]) - np.array(d["cp_set"])
        eff = np.mean(d_mal) / max(abs(np.mean(d_set)), 0.001)

        marker = 'o' if prefix == "INB" else 's'
        label = f"{prefix}_{method} ({eff:.2f}x)"

        ax.scatter(d_set, d_mal, color=color, alpha=0.3, s=30, marker=marker)
        ax.errorbar(np.mean(d_set), np.mean(d_mal),
                   xerr=np.std(d_set), yerr=np.std(d_mal),
                   color=color, capsize=4, marker=marker, markersize=10,
                   markeredgecolor='black', markeredgewidth=0.5,
                   label=label, linewidth=1.5, zorder=5)

ax.axhline(y=0, color='black', linestyle='-', alpha=0.3, linewidth=0.5)
ax.axvline(x=0, color='black', linestyle='-', alpha=0.3, linewidth=0.5)
ax.text(0.30, 0.20, "TRIVIAL\n(+set, +cov)", fontsize=9, color='orange',
       ha='center', alpha=0.5, style='italic')
ax.text(-0.08, 0.20, "IDEAL\n(-set, +cov)", fontsize=9, color='green',
       ha='center', alpha=0.5, style='italic')
ax.text(0.30, -0.08, "HARMFUL\n(+set, -cov)", fontsize=9, color='red',
       ha='center', alpha=0.5, style='italic')
ax.text(-0.08, -0.08, "TIGHTER\n(-set, -cov)", fontsize=9, color='blue',
       ha='center', alpha=0.5, style='italic')

for eff_line in [0.5, 1.0, 2.0]:
    x_line = np.linspace(0.01, 0.5, 50)
    ax.plot(x_line, eff_line * x_line, '--', color='gray', alpha=0.15, linewidth=0.5)

ax.legend(fontsize=8, loc='upper left', framealpha=0.9)
ax.set_xlim(-0.20, 0.55)
ax.set_ylim(-0.20, 0.35)
ax.grid(True, alpha=0.2)
plt.tight_layout()
plt.savefig(FIGS / "fig1_tacp_efficiency.png")
plt.savefig(FIGS / "fig1_tacp_efficiency.pdf")
print(f"  Saved: {FIGS}/fig1_tacp_efficiency.png")
print(f"  Saved: {FIGS}/fig1_tacp_efficiency.pdf")
plt.show()
plt.close()


# ═══════════════════════════════════════════════════════════
# FIGURE 2: CP vs TACP ARROW PLOT
# ═══════════════════════════════════════════════════════════
print(f"\n{'='*70}")
print(f" FIGURE 2: Malignant Risk Curves (CP -> TACP)")
print(f"{'='*70}")

fig, ax = plt.subplots(figsize=(8, 6))
ax.set_title("TACP Effect on Malignant Coverage\n(arrows: CP $\\rightarrow$ TACP)", fontweight='bold')
ax.set_xlabel("Average Prediction Set Size")
ax.set_ylabel("Malignant Class Coverage")

for method, color in method_colors.items():
    for prefix in ["INB", "CBIS"]:
        exp_name = f"{prefix}_{method}"
        d = method_data.get(exp_name)
        if not d or not d["cp_mal"]:
            continue

        cp_s = np.mean(d["cp_set"])
        cp_m = np.mean(d["cp_mal"])
        tacp_s = np.mean(d["tacp_set"])
        tacp_m = np.mean(d["tacp_mal"])

        marker = 'o' if prefix == "INB" else 's'

        ax.scatter(cp_s, cp_m, color=color, s=80, marker=marker,
                  zorder=5, edgecolors='black', linewidth=0.5)
        ax.scatter(tacp_s, tacp_m, color=color, s=120, marker='*',
                  zorder=5, edgecolors='black', linewidth=0.5)
        ax.annotate('', xy=(tacp_s, tacp_m), xytext=(cp_s, cp_m),
                   arrowprops=dict(arrowstyle='->', color=color, lw=2.5))
        ax.text(cp_s - 0.01, cp_m - 0.015,
               f"{prefix}_{method}", fontsize=7, color=color, ha='right')

ax.axhline(y=0.95, color='gray', linestyle='--', alpha=0.5, label='95% target')

from matplotlib.lines import Line2D
legend_elements = [
    Line2D([0], [0], marker='o', color='gray', label='CP (standard)',
           markersize=8, linestyle='None'),
    Line2D([0], [0], marker='*', color='gray', label='TACP (adaptive)',
           markersize=12, linestyle='None'),
    Line2D([0], [0], color='gray', linestyle='--', label='95% coverage target'),
]
ax.legend(handles=legend_elements, fontsize=9, loc='lower right')
ax.set_xlim(1.3, 2.15)
ax.set_ylim(0.6, 1.05)
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig(FIGS / "fig2_malignant_risk_curves.png")
plt.savefig(FIGS / "fig2_malignant_risk_curves.pdf")
print(f"  Saved: {FIGS}/fig2_malignant_risk_curves.png")
print(f"  Saved: {FIGS}/fig2_malignant_risk_curves.pdf")
plt.show()
plt.close()


# ═══════════════════════════════════════════════════════════
# FIGURE 3: RISK-COVERAGE CURVES
# ═══════════════════════════════════════════════════════════
print(f"\n{'='*70}")
print(f" FIGURE 3: Risk-Coverage Curves")
print(f"{'='*70}")

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# 3a: Selective accuracy vs acceptance rate
ax1 = axes[0]
ax1.set_title("Selective Accuracy vs Acceptance Rate", fontweight='bold')
ax1.set_xlabel("Acceptance Rate (fraction predicted on)")
ax1.set_ylabel("Accuracy on Accepted Samples")

for method, color in method_colors.items():
    for prefix in ["INB", "CBIS"]:
        exp_name = f"{prefix}_{method}"
        seeds = [r for r in rs if r["exp"] == exp_name]
        if not seeds:
            continue

        all_rates = defaultdict(list)
        all_accs = defaultdict(list)
        for r in seeds:
            for entry in r.get("sel_sweep", []):
                all_rates[entry["pct"]].append(entry["acc_rate"])
                all_accs[entry["pct"]].append(entry["acc_acc"])

        if not all_rates:
            continue

        pcts = sorted(all_rates.keys())
        mean_rates = [np.mean(all_rates[p]) for p in pcts]
        mean_accs = [np.mean(all_accs[p]) for p in pcts]
        std_accs = [np.std(all_accs[p]) for p in pcts]

        ls = '-' if prefix == "INB" else '--'
        ax1.plot(mean_rates, mean_accs, color=color,
                label=f"{prefix}_{method}", linewidth=2,
                marker='o', markersize=3, linestyle=ls)
        ax1.fill_between(mean_rates,
                        [m - s for m, s in zip(mean_accs, std_accs)],
                        [m + s for m, s in zip(mean_accs, std_accs)],
                        color=color, alpha=0.08)

ax1.legend(fontsize=7, loc='lower left', ncol=2)
ax1.grid(True, alpha=0.3)
ax1.set_xlim(0, 1)
ax1.set_ylim(0.4, 1.05)

# 3b: Recall boxplot
ax2 = axes[1]
ax2.set_title("Malignant Recall (Sensitivity) by Method", fontweight='bold')

methods_recall = defaultdict(list)
for r in rs:
    method_short = r["exp"].split("_", 1)[1] if "_" in r["exp"] else r["exp"]
    prefix = r["exp"].split("_")[0]
    label = f"{prefix}_{method_short}"
    sens = r.get("sens", r["tp"] / max(r["tp"] + r["fn"], 1))
    methods_recall[label].append(sens)

labels_sorted = sorted(methods_recall.keys(),
                      key=lambda m: np.mean(methods_recall[m]))
data_sorted = [methods_recall[m] for m in labels_sorted]
colors_sorted = []
for lab in labels_sorted:
    method_short = lab.split("_", 1)[1] if "_" in lab else lab
    colors_sorted.append(method_colors.get(method_short, 'gray'))

bp = ax2.boxplot(data_sorted, positions=list(range(len(labels_sorted))),
                widths=0.6, patch_artist=True)
for patch, color in zip(bp['boxes'], colors_sorted):
    patch.set_facecolor(color)
    patch.set_alpha(0.5)
    patch.set_edgecolor('black')

ax2.set_xticks(list(range(len(labels_sorted))))
ax2.set_xticklabels(labels_sorted, rotation=45, ha='right', fontsize=8)
ax2.set_ylabel("Malignant Recall (Sensitivity)")
ax2.grid(True, alpha=0.3, axis='y')

plt.tight_layout()
plt.savefig(FIGS / "fig3_risk_coverage.png")
plt.savefig(FIGS / "fig3_risk_coverage.pdf")
print(f"  Saved: {FIGS}/fig3_risk_coverage.png")
print(f"  Saved: {FIGS}/fig3_risk_coverage.pdf")
plt.show()
plt.close()


# ═══════════════════════════════════════════════════════════
# FIGURE 4: GAMMA SENSITIVITY COMPARISON
# ═══════════════════════════════════════════════════════════
print(f"\n{'='*70}")
print(f" FIGURE 4: TACP Gamma Sensitivity (Topo vs Non-Topo)")
print(f"{'='*70}")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

for ax_idx, prefix in enumerate(["INB", "CBIS"]):
    ax = axes[ax_idx]
    ax.set_title(f"{prefix}: TACP Set Size vs Gamma", fontweight='bold')
    ax.set_xlabel(r"$\gamma$ (topology sensitivity)")
    ax.set_ylabel("Mean TACP Set Size")

    has_data = False
    for method, color in method_colors.items():
        exp_name = f"{prefix}_{method}"
        seeds = [r for r in rs if r["exp"] == exp_name and "tacp_sweep" in r]
        if not seeds:
            continue

        gamma_sets = defaultdict(list)
        for r in seeds:
            a05 = [x for x in r["tacp_sweep"]
                   if abs(x["alpha"] - 0.05) < 0.001]
            for entry in a05:
                gamma_sets[entry["gamma"]].append(entry["tacp_avg_set_size"])

        if not gamma_sets:
            continue

        has_data = True
        gammas = sorted(gamma_sets.keys())
        means = [np.mean(gamma_sets[g]) for g in gammas]
        stds = [np.std(gamma_sets[g]) for g in gammas]

        ax.errorbar(gammas, means, yerr=stds, color=color,
                   label=method, linewidth=2, marker='o',
                   markersize=6, capsize=3)

    if has_data:
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)
        ax.set_xlim(0.15, 1.1)
    else:
        ax.text(0.5, 0.5, f"No {prefix} data yet",
               ha='center', va='center', transform=ax.transAxes,
               fontsize=14, color='gray')

plt.tight_layout()
plt.savefig(FIGS / "fig4_gamma_sensitivity.png")
plt.savefig(FIGS / "fig4_gamma_sensitivity.pdf")
print(f"  Saved: {FIGS}/fig4_gamma_sensitivity.png")
print(f"  Saved: {FIGS}/fig4_gamma_sensitivity.pdf")
plt.show()
plt.close()


