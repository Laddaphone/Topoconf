# FIGURE 5: PER-SEED DELTA WATERFALL
# ═══════════════════════════════════════════════════════════
print(f"\n{'='*70}")
print(f" FIGURE 5: Per-Seed TACP Effect (Waterfall)")
print(f"{'='*70}")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# 5a: Delta malignant coverage per seed
ax1 = axes[0]
ax1.set_title(r"Per-Seed $\Delta$ Malignant Coverage (TACP $-$ CP)", fontweight='bold')
ax1.set_ylabel(r"$\Delta$ Malignant Coverage")

