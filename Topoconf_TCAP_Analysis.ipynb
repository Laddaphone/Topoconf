ax1.set_xticklabels(bar_labels, rotation=90, fontsize=6)
ax1.grid(True, alpha=0.2, axis='y')

# 5b: Delta set size per seed
ax2 = axes[1]
ax2.set_title(r"Per-Seed $\Delta$ Set Size (TACP $-$ CP)", fontweight='bold')
