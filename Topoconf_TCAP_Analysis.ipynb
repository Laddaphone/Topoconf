# ═══════════════════════════════════════════════════════════
# PUBLICATION READINESS CHECKLIST
# ═══════════════════════════════════════════════════════════
print(f"\n\n{'='*70}")
print(f" PUBLICATION READINESS CHECKLIST")
print(f"{'='*70}")

checks = []

tc = method_data.get("INB_TopoConf", {})
sm = method_data.get("INB_Softmax", {})

if tc.get("cp_mal") and tc.get("tacp_mal"):
    d = np.mean(tc["tacp_mal"]) - np.mean(tc["cp_mal"])
    checks.append(("TACP improves TopoConf mal coverage", d > 0, f"d={d:+.4f}"))

if tc.get("cp_set") and tc.get("tacp_set"):
    d_mal = np.mean(tc["tacp_mal"]) - np.mean(tc["cp_mal"])
    d_set = np.mean(tc["tacp_set"]) - np.mean(tc["cp_set"])
    eff = d_mal / max(abs(d_set), 0.001)
    checks.append(("TACP efficiency > 0.5x", eff > 0.5, f"eff={eff:.2f}x"))

if tc.get("cp_mal") and sm.get("cp_mal"):
    d_tc = np.mean(tc["tacp_mal"]) - np.mean(tc["cp_mal"])
    d_sm = np.mean(sm["tacp_mal"]) - np.mean(sm["cp_mal"])
    checks.append(("TACP benefits TopoConf > Softmax", d_tc > d_sm,
                   f"TC={d_tc:+.4f} SM={d_sm:+.4f}"))

if tc.get("cp_mal") and len(tc["cp_mal"]) >= 4:
    deltas = np.array(tc["tacp_mal"]) - np.array(tc["cp_mal"])
    loo_ok = all(np.mean(np.delete(deltas, i)) >= 0 for i in range(len(deltas)))
    min_loo = min(np.mean(np.delete(deltas, i)) for i in range(len(deltas)))
    checks.append(("Leave-one-out all positive", loo_ok, f"min={min_loo:+.4f}"))

if tc.get("cp_mal"):
    deltas = np.array(tc["tacp_mal"]) - np.array(tc["cp_mal"])
    n_pos = int(np.sum(deltas > 0.001))
    checks.append((f"Seeds with d_mal > 0", n_pos >= 2, f"{n_pos}/{len(deltas)}"))

# Check CBIS if available
cbis_tc = method_data.get("CBIS_TopoConf", {})
if cbis_tc.get("cp_mal"):
    d = np.mean(cbis_tc["tacp_mal"]) - np.mean(cbis_tc["cp_mal"])
    checks.append(("CBIS: TACP improves TopoConf", d > 0, f"d={d:+.4f}"))

for desc, passed, detail in checks:
    status = "PASS" if passed else "FAIL"
    icon = "+" if passed else "X"
    print(f"  [{icon}] {status}  {desc:45s} ({detail})")

n_pass = sum(1 for _, p, _ in checks if p)
print(f"\n  Score: {n_pass}/{len(checks)}")
if n_pass >= 4:
    print(f"  --> TACP narrative is PUBLISHABLE")
elif n_pass >= 3:
    print(f"  --> TACP narrative is WEAK, needs CBIS confirmation")
else:
    print(f"  --> TACP narrative FAILS, pivot to backup")

print(f"\n  All figures saved to: {FIGS}/")
print(f"  Files:")
for f in sorted(FIGS.glob("*")):
    size = f.stat().st_size / 1024
    print(f"    {f.name} ({size:.0f} KB)")