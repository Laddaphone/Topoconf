import json, numpy as np, pandas as pd, warnings
from pathlib import Path
from collections import defaultdict
from scipy.stats import mannwhitneyu
from sklearn.metrics import roc_auc_score
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
from itertools import combinations
warnings.filterwarnings("ignore")

plt.rcParams.update({
    'font.size': 9, 'font.family': 'serif',
    'font.serif': ['Times New Roman', 'DejaVu Serif'],
    'axes.labelsize': 10, 'axes.titlesize': 11, 'axes.titleweight': 'bold',
    'xtick.labelsize': 8, 'ytick.labelsize': 8, 'legend.fontsize': 7,
    'figure.dpi': 300, 'savefig.dpi': 300, 'savefig.bbox': 'tight',
    'savefig.pad_inches': 0.15,
    'axes.spines.top': False, 'axes.spines.right': False,
    'axes.grid': True, 'grid.alpha': 0.12, 'grid.linewidth': 0.4,
})

COLORS = {
    'NoTopo': '#0072B2', 'TopoConf': '#D55E00', 'Softmax': '#009E73',
    'MCDrop': '#E69F00', 'GCN': '#CC79A7', 'ResNet': '#56B4E9',
}

ROOT = Path("/content/drive/MyDrive/TopoConf_GNN")
RESULTS = ROOT / "results_v31"
POSTHOC = RESULTS / "posthoc_cache"
FIGDIR = ROOT / "Final_Figures"
FIGDIR.mkdir(parents=True, exist_ok=True)

print("Loading data...")
rs = [json.load(open(f)) for f in sorted(RESULTS.glob("*.json"))
      if not f.name.endswith(".csv")]
df = pd.DataFrame(rs)
print(f"  {len(rs)} results, {df['exp'].nunique()} experiments")

posthoc = {}
if POSTHOC.exists():
    for f in sorted(POSTHOC.glob("*.npz")):
        d = np.load(f, allow_pickle=True)
        posthoc[f.stem] = {k: d[k] for k in d.files}
    print(f"  {len(posthoc)} posthoc predictions")

def save_fig(fig, name):
    for ext in ['pdf', 'png', 'svg']:
        fig.savefig(FIGDIR / f"{name}.{ext}")
    print(f"  ✓ {name}")
    plt.close(fig)


# ═══════════════════════════════════════════════════════════
# FIGURE 2: MAIN RESULTS (3-panel)
# ═══════════════════════════════════════════════════════════
print("\nFigure 2: Main Results...")

fig = plt.figure(figsize=(16, 5))
gs = GridSpec(1, 3, figure=fig, width_ratios=[1.3, 1, 1], wspace=0.32)

# --- 2a: Sensitivity ---
ax = fig.add_subplot(gs[0])
ax.set_title('(a) Malignant Sensitivity', pad=10)

all_methods = ['GCN', 'MCDrop', 'NoTopo', 'ResNet', 'Softmax', 'TopoConf']
x = np.arange(len(all_methods))
width = 0.32

cbis_vals, cbis_errs, inb_vals, inb_errs = [], [], [], []
for m in all_methods:
    ce = f"CBIS_{m}"; ie = f"INB_{m}"
    cbis_vals.append(df[df["exp"]==ce]["sens"].mean() if ce in df["exp"].values else 0)
    cbis_errs.append(df[df["exp"]==ce]["sens"].std() if ce in df["exp"].values else 0)
    inb_vals.append(df[df["exp"]==ie]["sens"].mean() if ie in df["exp"].values else 0)
    inb_errs.append(df[df["exp"]==ie]["sens"].std() if ie in df["exp"].values else 0)

bars_c = ax.bar(x - width/2, cbis_vals, width, yerr=cbis_errs, capsize=2,
               color=[COLORS.get(m,'#888') for m in all_methods],
               alpha=0.85, edgecolor='black', linewidth=0.3, label='CBIS-DDSM',
               error_kw={'linewidth': 0.8})
bars_i = ax.bar(x + width/2, inb_vals, width, yerr=inb_errs, capsize=2,
               color=[COLORS.get(m,'#888') for m in all_methods],
               alpha=0.35, edgecolor='black', linewidth=0.3, hatch='///',
               label='INbreast', error_kw={'linewidth': 0.8})

# Value labels ABOVE error bars for CBIS only
for xi, v, e in zip(x, cbis_vals, cbis_errs):
    if v > 0:
        ax.text(xi - width/2, v + e + 0.025, f'{v:.3f}', ha='center',
                fontsize=6, fontweight='bold')

# Annotate +16% between NoTopo and ResNet
if 'NoTopo' in all_methods and 'ResNet' in all_methods:
    idx_nt = all_methods.index('NoTopo')
    idx_rs = all_methods.index('ResNet')
    v_nt = cbis_vals[idx_nt]; v_rs = cbis_vals[idx_rs]
    e_nt = cbis_errs[idx_nt]
    arrow_y = v_nt + e_nt + 0.07
    ax.annotate('', xy=(x[idx_nt]-width/2, arrow_y),
                xytext=(x[idx_rs]-width/2, arrow_y),
                arrowprops=dict(arrowstyle='<->', color='#CC0000', lw=1.2))
    mid_x = (x[idx_nt] + x[idx_rs]) / 2 - width/2
    ax.text(mid_x, arrow_y + 0.015, f'+{(v_nt-v_rs)*100:.1f}%',
            ha='center', fontsize=7.5, color='#CC0000', fontweight='bold')

ax.set_xticks(x)
ax.set_xticklabels(all_methods, rotation=40, ha='right')
ax.set_ylabel('Malignant Sensitivity')
ax.set_ylim(0, 1.12)
ax.legend(loc='upper left', framealpha=0.9)

# --- 2b: FN Caught ---
ax = fig.add_subplot(gs[1])
ax.set_title('(b) FN Caught by Triage (CBIS)', pad=10)

triage = defaultdict(lambda: {"fn_caught": []})
if posthoc:
    for key, d in posthoc.items():
        parts = key.rsplit("_s", 1)
        if len(parts) != 2: continue
        exp = parts[0]
        if not exp.startswith("CBIS"): continue
        epi = d["te"]; y = d["ty"]; pr = d["tpred"]
        e75 = np.percentile(d["ce"], 75); a75 = np.percentile(d["ca"], 75)
        fnt = 0; fnc = 0
        for i in range(len(y)):
            is_fn = (y[i] == 1 and pr[i] == 0)
            if is_fn: fnt += 1
            if epi[i] > e75: fnc += int(is_fn)
            elif d["ta"][i] > a75: fnc += int(is_fn)
        triage[exp]["fn_caught"].append(fnc / max(fnt, 1))

    sorted_keys = sorted(triage.keys(), key=lambda k: np.mean(triage[k]["fn_caught"]))
    methods_t = [k.split("_", 1)[1] for k in sorted_keys]
    fn_means = [np.mean(triage[k]["fn_caught"]) for k in sorted_keys]
    fn_stds = [np.std(triage[k]["fn_caught"]) for k in sorted_keys]

    bars = ax.bar(range(len(methods_t)), fn_means, yerr=fn_stds, capsize=2,
                  color=[COLORS.get(m, '#888') for m in methods_t],
                  alpha=0.85, edgecolor='black', linewidth=0.3,
                  error_kw={'linewidth': 0.8})
    # Labels above bars
    for i, (bar, v, e) in enumerate(zip(bars, fn_means, fn_stds)):
        ax.text(bar.get_x() + bar.get_width()/2, v + e + 0.025,
                f'{v:.0%}', ha='center', fontsize=7, fontweight='bold')

    ax.axhline(y=0.5, color='gray', linestyle='--', alpha=0.3, linewidth=0.6)
    ax.set_xticks(range(len(methods_t)))
    ax.set_xticklabels(methods_t, rotation=40, ha='right')

ax.set_ylabel('FN Caught Rate')
ax.set_ylim(0, 1.18)

# --- 2c: Ale vs Epi scatter ---
ax = fig.add_subplot(gs[2])
ax.set_title('(c) Ale vs Epi Error Prediction', pad=10)

if posthoc:
    for ds_mk, ds in [('o', 'CBIS'), ('s', 'INB')]:
        for mt in sorted(set(k.split("_s")[0].split("_", 1)[1]
                            for k in posthoc if k.startswith(ds))):
            key = f"{ds}_{mt}_s42"
            if key not in posthoc: continue
            d = posthoc[key]
            if d["terr"].sum() == 0 or d["terr"].sum() == len(d["terr"]): continue
            aa = roc_auc_score(d["terr"], d["ta"])
            ae = roc_auc_score(d["terr"], d["te"])
            c = COLORS.get(mt, '#888')
            sz = 60 if ds == 'CBIS' else 40
            ax.scatter(ae, aa, color=c, marker=ds_mk, s=sz,
                      edgecolors='black', linewidth=0.4, zorder=5)

    ax.plot([0.35, 0.82], [0.35, 0.82], 'k--', alpha=0.15, linewidth=0.6)
    ax.fill_between([0.35, 0.82], [0.35, 0.82], [0.82, 0.82],
                    alpha=0.03, color='green')
    ax.text(0.42, 0.76, 'Aleatoric\nwins', fontsize=7, color='#009E73',
            alpha=0.5, fontstyle='italic')

    # Manual legend
    for mt in ['NoTopo', 'TopoConf', 'Softmax', 'MCDrop', 'GCN']:
        ax.scatter([], [], color=COLORS[mt], marker='o', s=30, label=mt,
                  edgecolors='black', linewidth=0.3)
    ax.scatter([], [], marker='o', color='gray', s=25, label='CBIS',
              edgecolors='black', linewidth=0.3)
    ax.scatter([], [], marker='s', color='gray', s=25, label='INB',
              edgecolors='black', linewidth=0.3)
    ax.legend(fontsize=5.5, loc='lower right', ncol=2, framealpha=0.9,
             handletextpad=0.3, columnspacing=0.5)

ax.set_xlabel('AUROC (Epistemic → Error)')
ax.set_ylabel('AUROC (Aleatoric → Error)')
ax.set_xlim(0.38, 0.82); ax.set_ylim(0.38, 0.82)

save_fig(fig, 'Fig2_main_results')


# ═══════════════════════════════════════════════════════════
# FIGURE 3: CLINICAL TRIAGE
# ═══════════════════════════════════════════════════════════
print("Figure 3: Clinical Triage...")

fig, axes = plt.subplots(1, 2, figsize=(13, 5))

# 3a: Workload vs Safety
ax = axes[0]
ax.set_title('(a) Workload vs Safety Tradeoff', pad=10)

triage_full = defaultdict(lambda: {"fn_caught": [], "auto": [], "aacc": []})
if posthoc:
    for key, d in posthoc.items():
        parts = key.rsplit("_s", 1)
        if len(parts) != 2: continue
        exp = parts[0]
        epi = d["te"]; ale = d["ta"]; y = d["ty"]; pr = d["tpred"]
        e75 = np.percentile(d["ce"], 75); a75 = np.percentile(d["ca"], 75)
        fnt = 0; fnc = 0; auto_list = []
        for i in range(len(y)):
            is_fn = (y[i] == 1 and pr[i] == 0)
            if is_fn: fnt += 1
            if epi[i] > e75: fnc += int(is_fn)
            elif ale[i] > a75: fnc += int(is_fn)
            else: auto_list.append(i)
        n = len(y)
        aacc = sum(pr[i] == y[i] for i in auto_list) / max(len(auto_list), 1)
        triage_full[exp]["fn_caught"].append(fnc / max(fnt, 1))
        triage_full[exp]["auto"].append(len(auto_list) / n)
        triage_full[exp]["aacc"].append(aacc)

    for exp in sorted(triage_full.keys()):
        t = triage_full[exp]
        mt = exp.split("_", 1)[1]
        ds = "CBIS" if exp.startswith("CBIS") else "INB"
        c = COLORS.get(mt, '#888')
        mk = 'o' if ds == 'CBIS' else 's'
        sz = 100 if ds == 'CBIS' else 60
        ax.scatter(np.mean(t["auto"]), np.mean(t["fn_caught"]),
                  color=c, marker=mk, s=sz, edgecolors='black', linewidth=0.4,
                  zorder=5, label=f"{ds}:{mt}")
        ax.errorbar(np.mean(t["auto"]), np.mean(t["fn_caught"]),
                   xerr=np.std(t["auto"]), yerr=np.std(t["fn_caught"]),
                   color=c, alpha=0.2, capsize=2, linewidth=0.6, zorder=1)

ax.set_xlabel('Auto-Diagnosis Rate (workload reduction)')
ax.set_ylabel('FN Caught Rate (safety)')
ax.set_xlim(0.45, 0.85); ax.set_ylim(0.25, 1.08)
ax.axhline(y=0.5, color='gray', linestyle=':', alpha=0.2)
ax.legend(fontsize=5, loc='lower left', ncol=2, framealpha=0.9,
         handletextpad=0.3, columnspacing=0.5)

# 3b: Horizontal FN caught with CI (CBIS only)
ax = axes[1]
ax.set_title('(b) FN Caught with 95% CI (CBIS)', pad=10)

cbis_only = {k: v for k, v in triage_full.items() if k.startswith("CBIS")}
sorted_exps = sorted(cbis_only.keys(),
                    key=lambda k: np.mean(cbis_only[k]["fn_caught"]))
y_pos = np.arange(len(sorted_exps))

for i, exp in enumerate(sorted_exps):
    vals = np.array(cbis_only[exp]["fn_caught"])
    mu = np.mean(vals)
    boots = [np.mean(np.random.choice(vals, len(vals), replace=True))
             for _ in range(5000)]
    lo, hi = np.percentile(boots, [2.5, 97.5])
    mt = exp.split("_", 1)[1]
    c = COLORS.get(mt, '#888')

    ax.barh(i, mu, color=c, alpha=0.8, edgecolor='black', linewidth=0.3, height=0.55)
    ax.plot([lo, hi], [i, i], color='black', linewidth=1.8, zorder=10)
    ax.plot(lo, i, '|', color='black', markersize=8, markeredgewidth=1.5)
    ax.plot(hi, i, '|', color='black', markersize=8, markeredgewidth=1.5)
    # Text to the RIGHT of the CI whisker, not on top of bar
    ax.text(max(hi, mu) + 0.03, i, f'{mu:.0%} [{lo:.0%}, {hi:.0%}]',
            va='center', fontsize=7, fontweight='bold' if mu > 0.8 else 'normal')

ax.set_yticks(y_pos)
ax.set_yticklabels([e.split("_", 1)[1] for e in sorted_exps], fontsize=9)
ax.set_xlabel('FN Caught Rate')
ax.set_xlim(0, 1.35)
ax.axvline(x=0.5, color='gray', linestyle='--', alpha=0.2)
ax.invert_yaxis()

plt.tight_layout()
save_fig(fig, 'Fig3_clinical_triage')


# ═══════════════════════════════════════════════════════════
# FIGURE 4: UQ DECOMPOSITION
# ═══════════════════════════════════════════════════════════
print("Figure 4: UQ Decomposition...")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

if posthoc:
    uqr = defaultdict(lambda: {"ac": [], "aw": [], "ec": [], "ew": []})
    for key, d in posthoc.items():
        exp = key.rsplit("_s", 1)[0]
        c = d["terr"] == 0; w = d["terr"] == 1
        uqr[exp]["ac"].extend(d["ta"][c].tolist())
        uqr[exp]["aw"].extend(d["ta"][w].tolist())
        uqr[exp]["ec"].extend(d["te"][c].tolist())
        uqr[exp]["ew"].extend(d["te"][w].tolist())

    exps = sorted(uqr.keys())
    short_names = [e.replace("CBIS_", "C:").replace("INB_", "I:") for e in exps]
    pos = np.arange(len(exps))
    wd = 0.32

    for ax_i, (title, ka, kb) in enumerate([
        ("(a) Aleatoric: Correct vs Wrong", "ac", "aw"),
        ("(b) Epistemic: Correct vs Wrong", "ec", "ew")]):
        ax = axes[ax_i]
        ax.set_title(title, pad=10)
        va = [np.mean(uqr[e][ka]) if uqr[e][ka] else 0 for e in exps]
        vb = [np.mean(uqr[e][kb]) if uqr[e][kb] else 0 for e in exps]
        # Use SEM for error bars
        sa = [np.std(uqr[e][ka])/np.sqrt(max(len(uqr[e][ka]),1))
              if uqr[e][ka] else 0 for e in exps]
        sb = [np.std(uqr[e][kb])/np.sqrt(max(len(uqr[e][kb]),1))
              if uqr[e][kb] else 0 for e in exps]

        ax.bar(pos - wd/2, va, wd, yerr=sa, label='Correct',
               color='#4CAF50', alpha=0.7, edgecolor='black', linewidth=0.2,
               capsize=1.5, error_kw={'linewidth': 0.6})
        ax.bar(pos + wd/2, vb, wd, yerr=sb, label='Wrong',
               color='#F44336', alpha=0.7, edgecolor='black', linewidth=0.2,
               capsize=1.5, error_kw={'linewidth': 0.6})

        # Significance stars - positioned with offset to avoid overlap
        for i, e in enumerate(exps):
            if uqr[e][ka] and uqr[e][kb] and len(uqr[e][kb]) > 3:
                _, p = mannwhitneyu(uqr[e][ka], uqr[e][kb])
                if p < 0.001:
                    max_v = max(va[i]+sa[i], vb[i]+sb[i])
                    ax.text(i, max_v + 0.008, '***', ha='center', fontsize=5.5,
                            color='#333333')

        ax.set_xticks(pos)
        ax.set_xticklabels(short_names, rotation=50, ha='right', fontsize=6.5)
        ax.legend(fontsize=7, loc='upper right')
        ax.set_ylabel('Uncertainty (mean ± SEM)')

plt.tight_layout()
save_fig(fig, 'Fig4_uq_decomposition')


# ═══════════════════════════════════════════════════════════
# FIGURE 5: NEGATIVE RESULTS
# ═══════════════════════════════════════════════════════════
print("Figure 5: Negative Results...")

fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))

# 5a: TACP
ax = axes[0]
ax.set_title('(a) TACP: Change in Malignant Coverage', pad=10)

tacp_data = []
for exp in sorted(df["exp"].unique()):
    if exp.startswith("X_"): continue
    g = df[df["exp"] == exp]
    if "cov_c1" not in g.columns or "tacp_cov_c1" not in g.columns: continue
    cp = g["cov_c1"].dropna().values
    tacp_g = g["tacp_cov_c1"].dropna().values
    n = min(len(cp), len(tacp_g))
    if n < 3: continue
    delta = tacp_g[:n] - cp[:n]
    mu = np.mean(delta)
    # Bootstrap CI
    boots = [np.mean(np.random.choice(delta, len(delta), replace=True)) for _ in range(2000)]
    lo, hi = np.percentile(boots, [2.5, 97.5])
    tacp_data.append({"exp": exp, "mean": mu, "lo": lo, "hi": hi})

tacp_df = pd.DataFrame(tacp_data).sort_values("mean")
y_pos = np.arange(len(tacp_df))

for i, (_, row) in enumerate(tacp_df.iterrows()):
    mt = row["exp"].split("_", 1)[1]
    c = COLORS.get(mt, '#888')
    ax.barh(i, row["mean"], color=c, alpha=0.75, edgecolor='black',
            linewidth=0.3, height=0.55)
    ax.plot([row["lo"], row["hi"]], [i, i], color='black', linewidth=1.5, zorder=10)
    ax.plot(row["lo"], i, '|', color='black', markersize=6, markeredgewidth=1.2)
    ax.plot(row["hi"], i, '|', color='black', markersize=6, markeredgewidth=1.2)

ax.axvline(x=0, color='black', linewidth=0.6)
ax.set_yticks(y_pos)
ax.set_yticklabels(tacp_df["exp"].values, fontsize=7)
ax.set_xlabel(r'$\Delta$ Malignant Coverage (TACP − CP)')
ax.invert_yaxis()

# 5b: EACP epistemic AUROC
ax = axes[1]
ax.set_title('(b) EACP Prerequisite: Epistemic Error AUROC', pad=10)

if posthoc:
    auroc_data = []
    for key, d in posthoc.items():
        parts = key.rsplit("_s", 1)
        if len(parts) != 2: continue
        exp = parts[0]
        if d["terr"].sum() == 0 or d["terr"].sum() == len(d["terr"]): continue
        ae = roc_auc_score(d["terr"], d["te"])
        auroc_data.append({"exp": exp, "auc_epi": ae})

    auroc_df = pd.DataFrame(auroc_data)
    exp_stats = auroc_df.groupby("exp")["auc_epi"].agg(["mean", "std"]).sort_values("mean")
    y_pos = np.arange(len(exp_stats))

    for i, (exp, row) in enumerate(exp_stats.iterrows()):
        mt = exp.split("_", 1)[1]
        c = COLORS.get(mt, '#888')
        ax.barh(i, row["mean"], xerr=row["std"], color=c, alpha=0.75,
                edgecolor='black', linewidth=0.3, height=0.55,
                capsize=2, error_kw={'linewidth': 0.8})

    # "anti-predictive" labels far right, no overlap with bars
    for i, (exp, row) in enumerate(exp_stats.iterrows()):
        if row["mean"] < 0.5:
            ax.text(0.83, i, '← anti-predictive', va='center', fontsize=5.5,
                    color='#CC0000', fontstyle='italic')

    ax.axvline(x=0.5, color='#CC0000', linewidth=0.8, linestyle='--', alpha=0.4)
    ax.set_yticks(y_pos)
    ax.set_yticklabels(exp_stats.index, fontsize=7)
    ax.set_xlabel('AUROC (Epistemic → Error)')
    ax.set_xlim(0.35, 0.88)
    ax.invert_yaxis()

plt.tight_layout()
save_fig(fig, 'Fig5_negative_results')


# ═══════════════════════════════════════════════════════════
# FIGURE 6: LOGISTIC REGRESSION
# ═══════════════════════════════════════════════════════════
print("Figure 6: Logistic Regression...")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

if posthoc:
    lr_results = []
    for ds in ["CBIS", "INB"]:
        for mt in sorted(set(k.split("_s")[0].split("_", 1)[1]
                            for k in posthoc if k.startswith(ds))):
            seed_auc_ale, seed_auc_epi, seed_coef = [], [], []
            for seed in range(42, 52):
                key = f"{ds}_{mt}_s{seed}"
                if key not in posthoc: continue
                d = posthoc[key]
                if d["terr"].sum() < 3 or d["terr"].sum() > len(d["terr"]) - 3: continue
                sc = StandardScaler()
                X = sc.fit_transform(np.column_stack([d["ta"], d["te"]]))
                lr = LogisticRegression(max_iter=1000, random_state=42)
                lr.fit(X, d["terr"])
                seed_coef.append(lr.coef_[0])
                lr_a = LogisticRegression(max_iter=1000, random_state=42)
                lr_a.fit(X[:, 0:1], d["terr"])
                seed_auc_ale.append(roc_auc_score(d["terr"], lr_a.predict_proba(X[:, 0:1])[:, 1]))
                lr_e = LogisticRegression(max_iter=1000, random_state=42)
                lr_e.fit(X[:, 1:2], d["terr"])
                seed_auc_epi.append(roc_auc_score(d["terr"], lr_e.predict_proba(X[:, 1:2])[:, 1]))

            if len(seed_coef) >= 3:
                coefs = np.array(seed_coef)
                lr_results.append({
                    "label": f"{ds}:{mt}", "ds": ds, "mt": mt,
                    "ale_m": np.mean(seed_auc_ale), "ale_s": np.std(seed_auc_ale, ddof=1),
                    "epi_m": np.mean(seed_auc_epi), "epi_s": np.std(seed_auc_epi, ddof=1),
                    "ca_m": np.mean(coefs[:, 0]), "ca_s": np.std(coefs[:, 0], ddof=1),
                    "ce_m": np.mean(coefs[:, 1]), "ce_s": np.std(coefs[:, 1], ddof=1),
                })

    lr_df = pd.DataFrame(lr_results)

    # 6a: AUROC bars
    ax = axes[0]
    ax.set_title('(a) Error Prediction AUROC', pad=10)
    x = np.arange(len(lr_df)); wd = 0.32
    ax.bar(x - wd/2, lr_df["ale_m"], wd, yerr=lr_df["ale_s"],
           label='Aleatoric', color='#4CAF50', alpha=0.7, edgecolor='black',
           linewidth=0.2, capsize=1.5, error_kw={'linewidth': 0.6})
    ax.bar(x + wd/2, lr_df["epi_m"], wd, yerr=lr_df["epi_s"],
           label='Epistemic', color='#F44336', alpha=0.7, edgecolor='black',
           linewidth=0.2, capsize=1.5, error_kw={'linewidth': 0.6})
    ax.axhline(y=0.5, color='gray', linestyle='--', alpha=0.2)
    ax.set_xticks(x)
    ax.set_xticklabels(lr_df["label"], rotation=50, ha='right', fontsize=6.5)
    ax.set_ylabel('AUROC (uncertainty → error)')
    ax.legend(fontsize=7, loc='upper left')
    ax.set_ylim(0.42, 0.82)

    # 6b: Coefficient dot plot
    ax = axes[1]
    ax.set_title(r'(b) Regression Coefficients ($\beta$)', pad=10)
    x = np.arange(len(lr_df))
    ax.errorbar(x - 0.12, lr_df["ca_m"], yerr=lr_df["ca_s"],
               fmt='o', color='#4CAF50', capsize=2.5, markersize=5,
               label=r'$\beta_{ale}$', markeredgecolor='black',
               markeredgewidth=0.4, linewidth=0.8)
    ax.errorbar(x + 0.12, lr_df["ce_m"], yerr=lr_df["ce_s"],
               fmt='s', color='#F44336', capsize=2.5, markersize=5,
               label=r'$\beta_{epi}$', markeredgecolor='black',
               markeredgewidth=0.4, linewidth=0.8)
    ax.axhline(y=0, color='black', linewidth=0.5)
    ax.set_xticks(x)
    ax.set_xticklabels(lr_df["label"], rotation=50, ha='right', fontsize=6.5)
    ax.set_ylabel(r'Standardized $\beta$ (mean ± std across seeds)')
    ax.legend(fontsize=7)

plt.tight_layout()
save_fig(fig, 'Fig6_logreg_error')


# ═══════════════════════════════════════════════════════════
# SUPPLEMENTARY S1: EACP GAMMA SWEEP
# ═══════════════════════════════════════════════════════════
print("FigS1: EACP Sweep...")

if posthoc:
    class StdCP:
        def __init__(s, a=0.05): s.a = a; s.q = None
        def cal(s, p, y):
            n = len(y); sc = 1.0 - p[np.arange(n), y]
            s.q = float(np.quantile(sc, min(np.ceil((n+1)*(1-s.a))/n, 1.0), method="higher"))
        def sets(s, p):
            return [{k for k in range(p.shape[1]) if p[i, k] >= 1.0 - s.q}
                    or {int(np.argmax(p[i]))} for i in range(len(p))]

    class EACPcls:
        def __init__(s, a=0.05, g=0.5): s.a = a; s.g = g; s.qb = None; s.umin = 0; s.umax = 1
        def cal(s, p, y, unc):
            n = len(y); sc = 1.0 - p[np.arange(n), y]
            s.umin, s.umax = unc.min(), unc.max()
            un = (unc - s.umin) / (s.umax - s.umin) if s.umax > s.umin else np.zeros_like(unc)
            sa = sc / (1 + s.g * un)
            s.qb = float(np.quantile(sa, min(np.ceil((n+1)*(1-s.a))/n, 1.0), method="higher"))
        def sets(s, p, unc):
            un = np.clip((unc - s.umin) / (s.umax - s.umin), 0, 1) if s.umax > s.umin else np.zeros_like(unc)
            return [{k for k in range(p.shape[1]) if p[i, k] >= 1.0 - s.qb * (1 + s.g * un[i])}
                    or {int(np.argmax(p[i]))} for i in range(len(p))]

    def ev_mal(sets_out, y):
        mal = y == 1
        return sum(y[i] in sets_out[i] for i in range(len(y)) if mal[i]) / max(mal.sum(), 1)

    eacp_rows = []
    for key, d in posthoc.items():
        parts = key.rsplit("_s", 1)
        if len(parts) != 2: continue
        exp = parts[0]
        is_edl = any(x in exp for x in ["NoTopo", "TopoConf"])
        cal_unc = d["ce"] if is_edl else d["ca"]
        tst_unc = d["te"] if is_edl else d["ta"]
        scp = StdCP(0.05); scp.cal(d["cp"], d["cy"])
        cp_cm = ev_mal(scp.sets(d["tp"]), d["ty"])
        for gamma in [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0]:
            ea = EACPcls(0.05, gamma); ea.cal(d["cp"], d["cy"], cal_unc)
            ea_cm = ev_mal(ea.sets(d["tp"], tst_unc), d["ty"])
            eacp_rows.append({"exp": exp, "gamma": gamma, "dm": ea_cm - cp_cm})

    eacp_df = pd.DataFrame(eacp_rows)
    fig, ax = plt.subplots(figsize=(9, 5.5))
    ax.set_title(r'EACP: $\Delta$ Malignant Coverage vs $\gamma$', pad=10)
    for exp in sorted(eacp_df["exp"].unique()):
        sub = eacp_df[eacp_df["exp"] == exp]
        gammas = sorted(sub["gamma"].unique())
        means = [sub[sub["gamma"] == g]["dm"].mean() for g in gammas]
        stds = [sub[sub["gamma"] == g]["dm"].std() for g in gammas]
        mt = exp.split("_", 1)[1]
        c = COLORS.get(mt, '#888')
        ls = '-' if 'CBIS' in exp else '--'
        ax.errorbar(gammas, means, yerr=stds, label=exp, color=c, linestyle=ls,
                   linewidth=1.2, marker='o', capsize=2, markersize=3,
                   elinewidth=0.6)
    ax.axhline(y=0, color='black', linewidth=0.4, alpha=0.3)
    ax.set_xlabel(r'$\gamma$ (adaptive sensitivity)')
    ax.set_ylabel(r'$\Delta$ Malignant Coverage (EACP − CP)')
    ax.legend(fontsize=5, ncol=2, loc='upper left', framealpha=0.9)
    save_fig(fig, 'FigS1_eacp_sweep')


# ═══════════════════════════════════════════════════════════
# SUPPLEMENTARY S2: JACKKNIFE
# ═══════════════════════════════════════════════════════════
print("FigS2: Jackknife...")

fig, ax = plt.subplots(figsize=(9, 4.5))
ax.set_title('Leave-Two-Out Jackknife Stability (CBIS)', pad=10)

stability_data = []
edl_exp = "CBIS_NoTopo"
ga = df[df["exp"] == edl_exp].sort_values("seed")

for comp_name in ["Softmax", "GCN", "MCDrop", "ResNet", "TopoConf"]:
    comp_exp = f"CBIS_{comp_name}"
    gb = df[df["exp"] == comp_exp].sort_values("seed")
    if len(gb) < 5: continue
    common = sorted(set(ga["seed"]) & set(gb["seed"]))
    if len(common) < 5: continue
    va = ga[ga["seed"].isin(common)].sort_values("seed")["sens"].values
    vb = gb[gb["seed"].isin(common)].sort_values("seed")["sens"].values
    stable = sum(1 for drop in combinations(range(len(common)), 2)
                 if np.mean(va[[i for i in range(len(common)) if i not in drop]]) >
                    np.mean(vb[[i for i in range(len(common)) if i not in drop]]))
    total = len(list(combinations(range(len(common)), 2)))
    stability_data.append({"comp": comp_name, "pct": stable / total * 100})

stab_df = pd.DataFrame(stability_data).sort_values("pct")
y_pos = np.arange(len(stab_df))
colors_s = [COLORS.get(r["comp"], '#888') for _, r in stab_df.iterrows()]
bars = ax.barh(y_pos, stab_df["pct"].values, color=colors_s, alpha=0.8,
               edgecolor='black', linewidth=0.3, height=0.55)

for i, (_, row) in enumerate(stab_df.iterrows()):
    pct = row["pct"]
    label = "STABLE" if pct >= 95 else "MOSTLY" if pct >= 80 else "FRAGILE"
    c = '#2E7D32' if pct >= 95 else '#F57F17' if pct >= 80 else '#C62828'
    ax.text(pct + 1.5, i, f'{pct:.0f}% — {label}', va='center', fontsize=8,
            fontweight='bold', color=c)

ax.axvline(x=95, color='#2E7D32', linestyle='--', alpha=0.2)
ax.axvline(x=80, color='#F57F17', linestyle='--', alpha=0.2)
ax.set_yticks(y_pos)
ax.set_yticklabels([f"NoTopo > {r['comp']}" for _, r in stab_df.iterrows()], fontsize=9)
ax.set_xlabel('% of Combinations Where NoTopo Wins')
ax.set_xlim(0, 112)

save_fig(fig, 'FigS2_jackknife')


