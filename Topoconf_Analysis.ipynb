lr_results = []
if posthoc_preds:
    for ds in ["CBIS", "INB"]:
        for mt in sorted(set(k.split("_s")[0].split("_",1)[1]
                            for k in posthoc_preds if k.startswith(ds))):
            seed_coefs = []
            seed_auc_ale = []
            seed_auc_epi = []
            seed_auc_full = []

            for seed in range(42, 52):
                key = f"{ds}_{mt}_s{seed}"
                if key not in posthoc_preds: continue
                d = posthoc_preds[key]
                errs = d["terr"]; ales = d["ta"]; epis = d["te"]
                if errs.sum() < 3 or errs.sum() > len(errs)-3: continue

                sc = StandardScaler()
                X = sc.fit_transform(np.column_stack([ales, epis]))

                # Full model
                lr = LogisticRegression(max_iter=1000, random_state=42)
                lr.fit(X, errs)
                seed_coefs.append(lr.coef_[0])
                seed_auc_full.append(roc_auc_score(errs, lr.predict_proba(X)[:,1]))

                # Ale only
                lr_a = LogisticRegression(max_iter=1000, random_state=42)
                lr_a.fit(X[:,0:1], errs)
                seed_auc_ale.append(roc_auc_score(errs, lr_a.predict_proba(X[:,0:1])[:,1]))

                # Epi only
                lr_e = LogisticRegression(max_iter=1000, random_state=42)
                lr_e.fit(X[:,1:2], errs)
                seed_auc_epi.append(roc_auc_score(errs, lr_e.predict_proba(X[:,1:2])[:,1]))

            if len(seed_coefs) >= 3:
                coefs = np.array(seed_coefs)
                lr_results.append({
                    "ds": ds, "mt": mt, "n_seeds": len(seed_coefs),
                    "coef_ale_mean": np.mean(coefs[:,0]),
                    "coef_ale_std": np.std(coefs[:,0], ddof=1),
                    "coef_epi_mean": np.mean(coefs[:,1]),
                    "coef_epi_std": np.std(coefs[:,1], ddof=1),
                    "auc_ale_mean": np.mean(seed_auc_ale),
                    "auc_ale_std": np.std(seed_auc_ale, ddof=1),
                    "auc_epi_mean": np.mean(seed_auc_epi),
                    "auc_epi_std": np.std(seed_auc_epi, ddof=1),
                    "auc_full_mean": np.mean(seed_auc_full),
                    "auc_full_std": np.std(seed_auc_full, ddof=1),
                })

    if lr_results:
        print(f"\n  {'Experiment':>20s} | {'β_ale':>12s} {'β_epi':>12s} | {'AUC_ale':>12s} {'AUC_epi':>12s} {'AUC_both':>12s} | {'Winner':>6s}")
        print(f"  {'-'*20} | {'-'*12} {'-'*12} | {'-'*12} {'-'*12} {'-'*12} | {'-'*6}")
        for r in lr_results:
            w = "ALE" if r["auc_ale_mean"] > r["auc_epi_mean"] else "EPI"
            print(f"  {r['ds']:>4s}_{r['mt']:<14s} | "
                  f"{r['coef_ale_mean']:+.3f}±{r['coef_ale_std']:.3f} "
                  f"{r['coef_epi_mean']:+.3f}±{r['coef_epi_std']:.3f} | "
                  f"{r['auc_ale_mean']:.4f}±{r['auc_ale_std']:.4f} "
                  f"{r['auc_epi_mean']:.4f}±{r['auc_epi_std']:.4f} "
                  f"{r['auc_full_mean']:.4f}±{r['auc_full_std']:.4f} | {w:>6s}")

        ale_wins = sum(1 for r in lr_results if r["auc_ale_mean"] > r["auc_epi_mean"])
        print(f"\n  Aleatoric wins: {ale_wins}/{len(lr_results)} experiments")
        print(f"  → Aleatoric uncertainty dominates error prediction in mammography")
        print(f"  (Per-seed fitting, {lr_results[0]['n_seeds']} seeds, no pseudoreplication)")


