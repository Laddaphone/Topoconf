# 8. GRAPH vs CNN META-COMPARISON
# ═══════════════════════════════════════════════════════════
print(f"\n\n{'='*70}")
print(f" 8. GRAPH vs CNN META-COMPARISON")
print(f"{'='*70}")

for ds in ["CBIS", "INB"]:
    graph_methods = [f"{ds}_NoTopo", f"{ds}_TopoConf", f"{ds}_Softmax",
                     f"{ds}_MCDrop", f"{ds}_GCN"]
    cnn_methods = [f"{ds}_ResNet"]

    graph_sens, cnn_sens, graph_auc, cnn_auc = [], [], [], []
    for seed in range(42, 52):
        gs = [df[(df["exp"]==m)&(df["seed"]==seed)]["sens"].values
              for m in graph_methods if m in df["exp"].values]
        gs = [v[0] for v in gs if len(v)>0]
        cs = [df[(df["exp"]==m)&(df["seed"]==seed)]["sens"].values
              for m in cnn_methods if m in df["exp"].values]
        cs = [v[0] for v in cs if len(v)>0]
        if gs and cs:
            graph_sens.append(np.mean(gs)); cnn_sens.append(np.mean(cs))
        ga = [df[(df["exp"]==m)&(df["seed"]==seed)]["auc"].values
              for m in graph_methods if m in df["exp"].values]
        ga = [v[0] for v in ga if len(v)>0]
        ca = [df[(df["exp"]==m)&(df["seed"]==seed)]["auc"].values
              for m in cnn_methods if m in df["exp"].values]
        ca = [v[0] for v in ca if len(v)>0]
        if ga and ca:
            graph_auc.append(np.mean(ga)); cnn_auc.append(np.mean(ca))

    if len(graph_sens) >= 3:
        md_s, clo_s, chi_s = bootstrap_ci_diff(graph_sens, cnn_sens)
        cd_s = cohens_d(graph_sens, cnn_sens)
        try: _, pw_s = wilcoxon(np.array(graph_sens)-np.array(cnn_sens))
        except: pw_s = 1.0
        md_a, clo_a, chi_a = bootstrap_ci_diff(graph_auc, cnn_auc)
        cd_a = cohens_d(graph_auc, cnn_auc)

        print(f"\n  {ds}:")
        print(f"    Sensitivity: Graph={np.mean(graph_sens):.4f} CNN={np.mean(cnn_sens):.4f}")
        print(f"      Δ={md_s:+.4f} [{clo_s:+.4f},{chi_s:+.4f}] d={cd_s:+.3f} p={pw_s:.4f}")
        if md_s > 0:
            print(f"      → Graph models detect {md_s*100:+.1f} more cancers per 100")
        print(f"    AUC: Graph={np.mean(graph_auc):.4f} CNN={np.mean(cnn_auc):.4f}")
        print(f"      Δ={md_a:+.4f} [{clo_a:+.4f},{chi_a:+.4f}] d={cd_a:+.3f}")
    else:
        print(f"\n  {ds}: ResNet not available — run v3.3 first")


