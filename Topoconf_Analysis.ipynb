    edl = [f"{ds}_NoTopo", f"{ds}_TopoConf"]
    nonedl = [f"{ds}_Softmax", f"{ds}_GCN", f"{ds}_MCDrop", f"{ds}_ResNet"]
    best_edl = max([e for e in edl if e in df["exp"].values],
                   key=lambda e: df[df["exp"]==e]["sens"].mean(), default=None)

    if best_edl:
        edl_name = best_edl.split("_",1)[1]
        print(f"\n  ABSOLUTE RISK REDUCTION ({ds}, {edl_name} vs others):")
        for comp in nonedl:
            if comp not in df["exp"].values: continue
            va = df[df["exp"]==best_edl].sort_values("seed")["sens"].values
            vb = df[df["exp"]==comp].sort_values("seed")["sens"].values
            n = min(len(va), len(vb))
            if n < 3: continue
            md, clo, chi = bootstrap_ci_diff(va[:n], vb[:n])
