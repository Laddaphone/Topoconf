# ═══════════════════════════════════════════════════════════
# HELPERS
# ═══════════════════════════════════════════════════════════
def bootstrap_ci_diff(a, b, n_boot=5000, ci=95):
    a, b = np.array(a), np.array(b)
    diffs = a - b
    boots = [np.mean(np.random.choice(diffs, len(diffs), replace=True)) for _ in range(n_boot)]
    lo, hi = np.percentile(boots, [(100-ci)/2, 100-(100-ci)/2])
    return float(np.mean(diffs)), float(lo), float(hi)

def bootstrap_ci_single(vals, n_boot=5000, ci=95):
    vals = np.array(vals)
    if len(vals) < 2: return float(vals[0]), float(vals[0]), float(vals[0])
    boots = [np.mean(np.random.choice(vals, len(vals), replace=True)) for _ in range(n_boot)]
    lo, hi = np.percentile(boots, [(100-ci)/2, 100-(100-ci)/2])
    return float(np.mean(vals)), float(lo), float(hi)

def cohens_d(a, b):
    d = np.array(a) - np.array(b)
    s = np.std(d, ddof=1)
    return float(np.mean(d) / s) if s > 0 else 0.0

def cliffs_delta(a, b):
    a, b = np.array(a), np.array(b)
    n = len(a) * len(b)
    if n == 0: return 0.0
    more = sum(1 for x in a for y in b if x > y)
    less = sum(1 for x in a for y in b if x < y)
    return float((more - less) / n)

def effect_label(d):
    ad = abs(d)
    if ad >= 0.8: return "large"
    if ad >= 0.5: return "medium"
    if ad >= 0.2: return "small"
    return "negligible"

def delong_test(y_true, pred_a, pred_b):
    n1 = sum(y_true == 1); n0 = sum(y_true == 0)
    if n1 < 2 or n0 < 2: return 0.0, 1.0
    auc_a = roc_auc_score(y_true, pred_a)
    auc_b = roc_auc_score(y_true, pred_b)
    pos_a, neg_a = pred_a[y_true==1], pred_a[y_true==0]
    pos_b, neg_b = pred_b[y_true==1], pred_b[y_true==0]
    v10_a = np.array([np.mean(neg_a<p)+0.5*np.mean(neg_a==p) for p in pos_a])
    v01_a = np.array([np.mean(pos_a>n)+0.5*np.mean(pos_a==n) for n in neg_a])
    v10_b = np.array([np.mean(neg_b<p)+0.5*np.mean(neg_b==p) for p in pos_b])
    v01_b = np.array([np.mean(pos_b>n)+0.5*np.mean(pos_b==n) for n in neg_b])
    s10 = np.cov(v10_a, v10_b)[0,1] if len(v10_a)>1 else 0
    s01 = np.cov(v01_a, v01_b)[0,1] if len(v01_a)>1 else 0
    sa = np.var(v10_a,ddof=1)/n1 + np.var(v01_a,ddof=1)/n0
    sb = np.var(v10_b,ddof=1)/n1 + np.var(v01_b,ddof=1)/n0
    sab = s10/n1 + s01/n0
    var_diff = sa + sb - 2*sab
    if var_diff <= 0: return 0.0, 1.0
    z = (auc_a - auc_b) / np.sqrt(var_diff)
    return float(z), float(2*norm.sf(abs(z)))

