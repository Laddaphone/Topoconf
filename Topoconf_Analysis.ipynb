            else: auto.append(i)
        n=len(y)
        triage[exp]["fn_caught"].append(fnc/max(fnt,1))
        triage[exp]["auto"].append(len(auto)/n)
        triage[exp]["aacc"].append(sum(pr[i]==y[i] for i in auto)/max(len(auto),1))

    print(f"\n  {'Experiment':25s} | {'FN Caught':>9s} {'95% CI':>18s} | {'Auto%':>6s} {'Acc':>6s}")
    print(f"  {'-'*25} | {'-'*9} {'-'*18} | {'-'*6} {'-'*6}")
    for exp in sorted(triage.keys()):
        t = triage[exp]
        mu, clo, chi = bootstrap_ci_single(t["fn_caught"])
        print(f"  {exp:25s} | {mu:>8.1%} [{clo:.3f},{chi:.3f}] | "
              f"{np.mean(t['auto']):>5.1%} {np.mean(t['aacc']):>6.3f}")

    # Paired: EDL vs non-EDL
    print(f"\n  PAIRED FN CAUGHT:")
    for ds in ["CBIS", "INB"]:
        edl_key = f"{ds}_NoTopo"
        for comp in [f"{ds}_Softmax", f"{ds}_GCN", f"{ds}_MCDrop"]:
            if edl_key not in triage or comp not in triage: continue
            va = np.array(triage[edl_key]["fn_caught"])
            vb = np.array(triage[comp]["fn_caught"])
            n = min(len(va), len(vb))
            if n < 3: continue
            md, clo, chi = bootstrap_ci_diff(va[:n], vb[:n])
            cd = cohens_d(va[:n], vb[:n])
            ci_excl = "★" if clo > 0 else ""
            cn = comp.split("_",1)[1]
            print(f"    {ds} NoTopo vs {cn:8s}: Δ={md:+.3f} [{clo:+.3f},{chi:+.3f}]{ci_excl} d={cd:+.3f}")


