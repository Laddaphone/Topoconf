delong_results = []
if posthoc_preds:
    for ds in ["CBIS", "INB"]:
        methods = sorted(set(k.split("_s")[0].split("_",1)[1]
                            for k in posthoc_preds if k.startswith(ds)))
        for ma in methods:
            for mb in methods:
                if ma >= mb: continue
                z_scores = []
                auc_as, auc_bs = [], []
                for seed in range(42, 52):
                    ka = f"{ds}_{ma}_s{seed}"; kb = f"{ds}_{mb}_s{seed}"
                    if ka not in posthoc_preds or kb not in posthoc_preds: continue
                    da, db = posthoc_preds[ka], posthoc_preds[kb]
                    if not np.array_equal(da["ty"], db["ty"]): continue
                    if da["terr"].sum() == 0 or da["terr"].sum() == len(da["terr"]): continue
                    z, p = delong_test(da["ty"], da["tp"][:,1], db["tp"][:,1])
                    if not np.isnan(z) and z != 0:
                        z_scores.append(z)
                        auc_as.append(roc_auc_score(da["ty"], da["tp"][:,1]))
                        auc_bs.append(roc_auc_score(db["ty"], db["tp"][:,1]))

                if len(z_scores) >= 3:
                    # Stouffer's method: combined_z = mean(z) * sqrt(n)
                    combined_z = np.mean(z_scores) * np.sqrt(len(z_scores))
                    combined_p = 2 * norm.sf(abs(combined_z))
                    delong_results.append({
                        "ds": ds, "ma": ma, "mb": mb,
                        "auc_a": np.mean(auc_as), "auc_b": np.mean(auc_bs),
                        "n_seeds": len(z_scores),
                        "mean_z": np.mean(z_scores), "combined_z": combined_z,
                        "combined_p": combined_p
                    })

    if delong_results:
        dl_pvals = [r["combined_p"] for r in delong_results]
        _, dl_corr, _, _ = multipletests(dl_pvals, method='holm')

        print(f"\n  {'Comparison':>25s} | {'AUC_A':>6s} {'AUC_B':>6s} | {'n':>2s} {'comb_z':>7s} {'p_raw':>7s} {'p_holm':>7s} {'Sig':>3s}")
        print(f"  {'-'*25} | {'-'*6} {'-'*6} | {'-'*2} {'-'*7} {'-'*7} {'-'*7} {'-'*3}")
        for i, r in enumerate(delong_results):
            sig = "*" if dl_corr[i] < 0.05 else ""
            print(f"  {r['ds']:>4s}:{r['ma']:>8s}v{r['mb']:<8s} | {r['auc_a']:>6.4f} {r['auc_b']:>6.4f} | "
                  f"{r['n_seeds']:>2d} {r['combined_z']:>+7.3f} {r['combined_p']:>7.4f} {dl_corr[i]:>7.4f} {sig:>3s}")
