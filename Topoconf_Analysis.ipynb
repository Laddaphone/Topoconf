    primary_pvals.append(pw)
    primary_meta.append((comp_name, md, clo, chi, cd, cliff, len(common)))

    ci_excl = "✓" if (clo > 0 or chi < 0) else ""
    is_primary = comp_name in [c[1] for c in PRIMARY_COMPARISONS]
    tag = " [PRIMARY]" if is_primary else ""

    print(f"\n  NoTopo vs {comp_name} (n={len(common)}){tag}:")
    print(f"    NoTopo sens:  {np.mean(va):.4f}")
    print(f"    {comp_name:8s} sens:  {np.mean(vb):.4f}")
